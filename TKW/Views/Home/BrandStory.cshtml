@{
    ViewBag.Title = "Giới Thiệu Về Nội Thất MOHO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Reset & Base */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .brand-story-page {
        font-family: 'SVN-Poppins', Arial, sans-serif;
        color: #333;
        background: #fff;
    }

    /* Top Banner Icons */
    .top-banner {
        background: #f8f8f8;
        padding: 20px 0;
        border-bottom: 1px solid #e5e5e5;
    }

    .banner-icons {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        padding: 0 20px;
    }

    .banner-item {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 20px;
        background: white;
        border-radius: 8px;
        transition: all 0.3s;
    }

    .banner-item:hover {
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transform: translateY(-3px);
    }

    .banner-item img {
        width: 50px;
        height: 50px;
    }

    .banner-item-text {
        text-align: left;
    }

    .banner-item-text h4 {
        font-size: 14px;
        font-weight: 600;
        color: #333;
        margin-bottom: 3px;
    }

    .banner-item-text p {
        font-size: 12px;
        color: #666;
    }

    /* HERO Section – Premium style */
    .hero-section {
        position: relative;
        height: 480px;
        background: url('https://theme.hstatic.net/200000065946/1001264503/14/brandstory_banner.jpg?v=1319')
                    center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);      /* nhẹ – giữ màu sản phẩm */
        backdrop-filter: blur(2px);          /* sang trọng */
    }

    .hero-content {
        position: relative;
        text-align: center;
        max-width: 780px;
        color: white;
        z-index: 2;
    }

    .hero-title {
        font-size: 52px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 18px;
        text-shadow: 0 3px 12px rgba(0,0,0,0.35);
    }

    .hero-subtitle {
        font-size: 20px;
        line-height: 1.7;
        opacity: 0.92;
        margin-bottom: 32px;
    }

    .hero-btn {
        display: inline-block;
        background: #d4a574;
        padding: 14px 40px;
        border-radius: 50px;
        color: white;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(212, 165, 116, 0.35);
        transition: 0.3s;
    }

    .hero-btn:hover {
        background: #c0925e;
        transform: translateY(-3px);
        box-shadow: 0 10px 26px rgba(212, 165, 116, 0.45);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .hero-section {
            height: 420px;
        }
        .hero-title {
            font-size: 34px;
        }
        .hero-subtitle {
            font-size: 16px;
        }
    }

    @@media (max-width: 480px) {
        .hero-title {
            font-size: 28px;
        }
        .hero-subtitle {
            font-size: 15px;
        }
    }

    /* Main Content */
    .main-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 80px 20px;
    }

    /* About Section */
    .about-section {
        margin-bottom: 100px;
    }

    .section-title {
        text-align: center;
        margin-bottom: 60px;
    }

    .section-title h2 {
        font-size: 42px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
    }

    .section-title p {
        font-size: 18px;
        color: #666;
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.8;
    }

    .about-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
        margin-bottom: 80px;
    }

    .about-content.reverse {
        direction: rtl;
    }

    .about-content.reverse > * {
        direction: ltr;
    }

    .about-image {
        position: relative;
        overflow: hidden;
        border-radius: 15px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }

    .about-image img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        transition: transform 0.5s;
    }

    .about-image:hover img {
        transform: scale(1.05);
    }

    .about-text h3 {
        font-size: 32px;
        color: #2c3e50;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .about-text p {
        font-size: 16px;
        line-height: 1.9;
        color: #555;
        margin-bottom: 20px;
    }

    .about-text ul {
        list-style: none;
        padding: 0;
        margin-top: 25px;
    }

    .about-text ul li {
        padding: 12px 0;
        padding-left: 30px;
        position: relative;
        font-size: 16px;
        color: #555;
    }

    .about-text ul li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: #d4a574;
        font-weight: bold;
        font-size: 18px;
    }

    /* Stats Section */
    .stats-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 80px 20px;
        margin: 80px 0;
        border-radius: 20px;
        color: white;
    }

    .stats-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px;
        text-align: center;
    }

    .stat-item h3 {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .stat-item p {
        font-size: 16px;
        opacity: 0.9;
    }

    /* Values Section */
    .values-section {
        margin: 100px 0;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-top: 60px;
    }

    .value-card {
        background: white;
        padding: 40px 30px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: all 0.3s;
    }

    .value-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }

    .value-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
    }

    .value-card h4 {
        font-size: 22px;
        color: #2c3e50;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .value-card p {
        font-size: 15px;
        color: #666;
        line-height: 1.7;
    }

    /* Timeline Section */
    .timeline-section {
        background: #f8f9fa;
        padding: 80px 20px;
        margin: 100px 0;
        border-radius: 20px;
    }

    .timeline {
        max-width: 900px;
        margin: 60px auto 0;
        position: relative;
        padding-left: 60px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 25px;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(to bottom, #667eea, #764ba2);
    }

    .timeline-item {
        position: relative;
        margin-bottom: 60px;
        padding-left: 40px;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -43px;
        top: 5px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: white;
        border: 4px solid #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.2);
    }

    .timeline-year {
        display: inline-block;
        padding: 8px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 30px;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .timeline-content h4 {
        font-size: 22px;
        color: #2c3e50;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .timeline-content p {
        font-size: 16px;
        color: #666;
        line-height: 1.8;
    }

    /* Team Section */
    .team-section {
        margin: 100px 0;
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
        margin-top: 60px;
    }

    .team-member {
        text-align: center;
        transition: transform 0.3s;
    }

    .team-member:hover {
        transform: translateY(-10px);
    }

    .team-photo {
        width: 100%;
        height: 280px;
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .team-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
    }

    .team-member:hover .team-photo img {
        transform: scale(1.1);
    }

    .team-member h4 {
        font-size: 18px;
        color: #2c3e50;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .team-member p {
        font-size: 14px;
        color: #d4a574;
        font-weight: 500;
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        padding: 80px 20px;
        text-align: center;
        color: white;
        border-radius: 20px;
        margin-top: 100px;
    }

    .cta-section h2 {
        font-size: 42px;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .cta-section p {
        font-size: 18px;
        margin-bottom: 40px;
        opacity: 0.9;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .cta-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .cta-btn {
        padding: 15px 40px;
        border-radius: 50px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-block;
    }

    .cta-btn.primary {
        background: #d4a574;
        color: white;
    }

    .cta-btn.primary:hover {
        background: #c49563;
        transform: translateY(-2px);
        box-shadow: 0 7px 20px rgba(212, 165, 116, 0.4);
    }

    .cta-btn.secondary {
        background: transparent;
        color: white;
        border: 2px solid white;
    }

    .cta-btn.secondary:hover {
        background: white;
        color: #2c3e50;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .banner-icons {
            grid-template-columns: repeat(2, 1fr);
        }

        .hero-content h1 {
            font-size: 42px;
        }

        .about-content {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .about-content.reverse {
            direction: ltr;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .values-grid {
            grid-template-columns: 1fr;
        }

        .team-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .hero-section {
            height: 500px;
        }

        .hero-content h1 {
            font-size: 32px;
        }

        .hero-content p {
            font-size: 16px;
        }

        .section-title h2 {
            font-size: 32px;
        }

        .banner-icons {
            grid-template-columns: 1fr;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .team-grid {
            grid-template-columns: 1fr;
        }

        .timeline {
            padding-left: 40px;
        }

        .cta-section h2 {
            font-size: 32px;
        }
    }
</style>

<div class="brand-story-page">

    <!-- Hero Section -->
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <h1 class="hero-title">MOHO – Nội Thất Hiện Đại</h1>
            <p class="hero-subtitle">
                Không gian sống của bạn xứng đáng được chăm chút bằng những thiết kế
                tinh giản, chất lượng và bền vững theo thời gian.
            </p>
            <a href="/SanPham" class="hero-btn">Khám Phá Sản Phẩm</a>
        </div>
    </section>


    <!-- Main Content -->
    <div class="main-content">

        <!-- About Section 1 -->
        <section class="about-section">
            <div class="section-title">
                <h2>Câu Chuyện Của Chúng Tôi</h2>
                <p>Hành trình kiến tạo những không gian sống đẹp, hiện đại và đầy cảm hứng</p>
            </div>

            <div class="about-content">
                <div class="about-image">
                    <img src="https://theme.hstatic.net/200000065946/1001264503/14/brandstory_img_1.jpg?v=1319" alt="MOHO Story 1">
                </div>
                <div class="about-text">
                    <h3>Khởi Đầu Từ Đam Mê</h3>
                    <p>
                        MOHO được thành lập với mong muốn mang đến cho mọi gia đình Việt Nam những sản phẩm
                        nội thất hiện đại, chất lượng cao với mức giá hợp lý. Chúng tôi tin rằng mỗi ngôi nhà
                        đều xứng đáng có một không gian sống đẹp, tiện nghi.
                    </p>
                    <p>
                        Với đội ngũ thiết kế tài năng và giàu kinh nghiệm, chúng tôi không ngừng nghiên cứu
                        và phát triển các sản phẩm mang phong cách tối giản, hiện đại nhưng vẫn ấm áp và gần gũi.
                    </p>
                    <ul>
                        <li>Thiết kế độc quyền bởi đội ngũ chuyên gia</li>
                        <li>Chất liệu cao cấp, thân thiện môi trường</li>
                        <li>Sản xuất theo tiêu chuẩn quốc tế</li>
                    </ul>
                </div>
            </div>

            <div class="about-content reverse">
                <div class="about-image">
                    <img src="https://theme.hstatic.net/200000065946/1001264503/14/brandstory_img_2.jpg?v=1319" alt="MOHO Story 2">
                </div>
                <div class="about-text">
                    <h3>Chất Lượng Là Ưu Tiên Hàng Đầu</h3>
                    <p>
                        Mỗi sản phẩm MOHO đều trải qua quy trình kiểm soát chất lượng nghiêm ngặt.
                        Chúng tôi sử dụng nguyên liệu thân thiện với môi trường, công nghệ sản xuất
                        tiên tiến và tuân thủ các tiêu chuẩn quốc tế.
                    </p>
                    <p>
                        Cam kết bảo hành lên đến 5 năm và chính sách đổi trả 1-1 trong 30 ngày là
                        minh chứng cho sự tự tin của chúng tôi về chất lượng sản phẩm.
                    </p>
                    <ul>
                        <li>Bảo hành chính hãng lên đến 5 năm</li>
                        <li>Đổi trả miễn phí trong 30 ngày đầu</li>
                        <li>Hỗ trợ khách hàng 24/7</li>
                    </ul>
                </div>
            </div>

            <div class="about-content">
                <div class="about-image">
                    <img src="https://theme.hstatic.net/200000065946/1001264503/14/brandstory_img_3.jpg?v=1319" alt="MOHO Story 3">
                </div>
                <div class="about-text">
                    <h3>Trải Nghiệm Khách Hàng Hoàn Hảo</h3>
                    <p>
                        Tại MOHO, chúng tôi không chỉ bán nội thất mà còn mang đến trải nghiệm mua sắm
                        trọn vẹn. Từ tư vấn thiết kế miễn phí, giao hàng nhanh chóng đến lắp đặt chuyên nghiệp.
                    </p>
                    <p>
                        Đội ngũ chăm sóc khách hàng tận tâm, nhiệt tình luôn sẵn sàng hỗ trợ và đảm bảo
                        bạn hoàn toàn hài lòng với sự lựa chọn của mình.
                    </p>
                    <ul>
                        <li>Tư vấn thiết kế miễn phí tại nhà</li>
                        <li>Giao hàng và lắp đặt chuyên nghiệp</li>
                        <li>Chăm sóc khách hàng tận tâm</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="stats-section">
            <div class="stats-grid">
                <div class="stat-item">
                    <h3>10+</h3>
                    <p>Năm Kinh Nghiệm</p>
                </div>
                <div class="stat-item">
                    <h3>150K+</h3>
                    <p>Khách Hàng Hài Lòng</p>
                </div>
                <div class="stat-item">
                    <h3>50+</h3>
                    <p>Showroom Toàn Quốc</p>
                </div>
                <div class="stat-item">
                    <h3>1000+</h3>
                    <p>Sản Phẩm Đa Dạng</p>
                </div>
            </div>
        </section>

        <!-- Values Section -->
        <section class="values-section">
            <div class="section-title">
                <h2>Giá Trị Cốt Lõi</h2>
                <p>Những giá trị mà MOHO luôn hướng tới trong từng sản phẩm và dịch vụ</p>
            </div>
            <div class="values-grid">
                <div class="value-card">
                    <div class="value-icon">🎨</div>
                    <h4>Thiết Kế Sáng Tạo</h4>
                    <p>
                        Luôn đổi mới và sáng tạo, mang đến những thiết kế độc đáo,
                        hiện đại phù hợp với xu hướng thế giới và gu thẩm mỹ Việt Nam.
                    </p>
                </div>
                <div class="value-card">
                    <div class="value-icon">✨</div>
                    <h4>Chất Lượng Vượt Trội</h4>
                    <p>
                        Cam kết chất lượng cao nhất, từ nguyên liệu, quy trình sản xuất
                        đến sản phẩm hoàn thiện và dịch vụ hậu mãi.
                    </p>
                </div>
                <div class="value-card">
                    <div class="value-icon">💚</div>
                    <h4>Thân Thiện Môi Trường</h4>
                    <p>
                        Ưu tiên sử dụng vật liệu bền vững, thân thiện với môi trường,
                        góp phần bảo vệ hành tinh xanh cho thế hệ tương lai.
                    </p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🤝</div>
                    <h4>Khách Hàng Là Trung Tâm</h4>
                    <p>
                        Đặt lợi ích và trải nghiệm khách hàng lên hàng đầu, luôn lắng nghe
                        và cải tiến không ngừng để mang đến sự hài lòng tối đa.
                    </p>
                </div>
                <div class="value-card">
                    <div class="value-icon">💎</div>
                    <h4>Giá Trị Bền Vững</h4>
                    <p>
                        Tạo ra những sản phẩm có giá trị lâu dài, không chỉ về chất lượng
                        mà còn về giá trị tinh thần và kỷ niệm cho gia đình.
                    </p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🚀</div>
                    <h4>Đổi Mới Liên Tục</h4>
                    <p>
                        Không ngừng học hỏi, cải tiến công nghệ và phương thức phục vụ
                        để mang đến trải nghiệm tốt nhất cho khách hàng.
                    </p>
                </div>
            </div>
        </section>

        <!-- Timeline Section -->
        <section class="timeline-section">
            <div class="section-title">
                <h2>Hành Trình Phát Triển</h2>
                <p>Những cột mốc đáng nhớ trong quá trình phát triển của MOHO</p>
            </div>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-year">2015</div>
                    <div class="timeline-content">
                        <h4>Khởi Đầu Hành Trình</h4>
                        <p>
                            MOHO được thành lập với showroom đầu tiên tại TP. Hồ Chí Minh,
                            mang đến những sản phẩm nội thất hiện đại đầu tiên cho thị trường Việt Nam.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-year">2017</div>
                    <div class="timeline-content">
                        <h4>Mở Rộng Quy Mô</h4>
                        <p>
                            Mở thêm 5 showroom tại các thành phố lớn: Hà Nội, Đà Nẵng, Cần Thơ.
                            Phục vụ hàng nghìn khách hàng mỗi tháng.
                        </p>
                    </div>
                </div>
