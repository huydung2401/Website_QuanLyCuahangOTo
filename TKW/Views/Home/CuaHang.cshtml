@{
    ViewBag.Title = "CuaHang";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/CuaHang.css" />

<body>
    <div class="container mt-5">

        <!-- 🔥 TIÊU ĐỀ CĂN GIỮA -->
        <h2 class="store-title text-center">Hệ thống cửa hàng - Hotline: 0967 390 575</h2>

        <!-- 🔗 BREADCRUMB CĂN GIỮA -->
        <p class="breadcrumb-text text-center">
            Trang chủ / <strong>Hệ thống cửa hàng - Hotline: 0967 390 575</strong>
        </p>

        <div class="row mt-4">

            <!-- LEFT PANEL - FORM -->
            <div class="col-md-4">
                <div class="store-box">

                    <h4 class="filter-title">Tìm cửa hàng</h4>

                    <!-- Chọn tỉnh -->
                    <label class="mt-3">Chọn tỉnh thành</label>
                    <select class="form-control">
                        <option>- Chọn Tỉnh thành -</option>
                        <option>Hồ Chí Minh</option>
                    </select>

                    <!-- Chọn cửa hàng -->
                    <label class="mt-3">Chọn cửa hàng</label>
                    <select id="selectStore" class="form-control">
                        <option value="">- Chọn cửa hàng -</option>
                        <option value="store1">Showroom MOHO Tân Thới Hiệp</option>
                        <option value="store2">Showroom MOHO Vinhomes Grand Park</option>
                    </select>

                    <!-- STORE 1 INFO -->
                    <div id="storeInfo" class="mt-4">
                        <h5>📍 Showroom MOHO Tân Thới Hiệp</h5>
                        <p>162 HT17, P. Tân Thới Hiệp, Q12, TP.HCM</p>
                        <p>Điện thoại: 0967 390 575</p>
                        <a href="#" class="map-link">Xem bản đồ</a>
                    </div>

                    <!-- STORE 2 INFO -->
                    <div id="storeInfo2" class="mt-4 d-none">
                        <h5>📍 Showroom MOHO Vinhomes Grand Park</h5>
                        <p>S05.03-S18 khu The Rainbow, Vinhomes Grand Park, TP.Thủ Đức</p>
                        <p>Điện thoại: 0967 390 575</p>
                        <a href="#" class="map-link">Xem bản đồ</a>
                    </div>

                </div>
            </div>

            <!-- RIGHT PANEL - GOOGLE MAP -->
            <div class="col-md-8">
                <iframe id="mapFrame"
                        src="https://maps.google.com/maps?q=162%20HT17,%20Tan%20Thoi%20Hiep,%20Quan%2012&t=&z=15&ie=UTF8&iwloc=&output=embed"
                        width="100%" height="500" frameborder="0"
                        style="border-radius: 12px;">
                </iframe>
            </div>
        </div>
    </div>

    <!-- 🔥 KHOẢNG CÁCH DƯỚI GIỐNG MOHO -->
    <div class="page-bottom-space"></div>

    <script src="~/Scripts/index.js"></script>

</body>
