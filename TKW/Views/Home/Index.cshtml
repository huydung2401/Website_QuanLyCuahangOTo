        <div class="container mt-5">
            <h2 class="section-title">Báo chí</h2>
            <div class="news-slider-wrapper">
                <div class="news-slider">
                    <div class="news-track">
                        <div class="news-item"><img src="~/Content/images/news1.png" /><h4>[Advertising Vietnam] MOHO – Made in Việt Nam...</h4><a class="more-link" href="#">Xem thêm</a></div>
                        <div class="news-item"><img src="~/Content/images/news2.png" /><h4>[Công Thương] Nội thất MOHO gia nhập thị trường...</h4><a class="more-link" href="#">Xem thêm</a></div>
