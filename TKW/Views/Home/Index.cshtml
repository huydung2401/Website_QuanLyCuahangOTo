@model List<TKW.Models.SanPham>
@using System.Globalization
@using TKW.Models

@{
    ViewBag.Title = "Trang chủ - Moho Furniture";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KHỞI TẠO DB
    QLMohoDBEntities2 db = new QLMohoDBEntities2();

    // 2. ÉP KIỂU DỮ LIỆU (Tránh lỗi Dynamic)
    var listGiaTot = ViewBag.GiaTot as List<SanPham>;
    var listBanChay = ViewBag.BanChay as List<SanPham>;
    var listBep = ViewBag.Bep as List<SanPham>;

    // 3. Định dạng tiền tệ
    var culture = new CultureInfo("vi-VN");
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/css/site.css" />
    <link rel="stylesheet" href="~/Content/css/index.css" />


    <body>
        <div class="carousel-wrapper mt-3">
            <div id="mainCarousel" class="carousel slide carousel-fade" data-ride="carousel" data-interval="3000">
                <ol class="carousel-indicators">
                    <li data-target="#mainCarousel" data-slide-to="0" class="active"></li>
                </ol>
                <div class="carousel-inner text-center">
                    <div class="carousel-item active"><img src="~/Content/images/carousel02.jpg" class="d-block w-100 carousel-img" alt="Slide 1"></div>
                    <div class="carousel-item"><img src="~/Content/images/carousel06.jpg" class="d-block w-100 carousel-img" alt="Slide 2"></div>
                    <div class="carousel-item"><img src="~/Content/images/carousel03.jpg" class="d-block w-100 carousel-img" alt="Slide 3"></div>
                    <div class="carousel-item"><img src="~/Content/images/carousel04.jpg" class="d-block w-100 carousel-img" alt="Slide 4"></div>
                    <div class="carousel-item"><img src="~/Content/images/carousel05.jpg" class="d-block w-100 carousel-img" alt="Slide 5"></div>
                </div>


                <!-- Nút điều hướng -->
                <a class="carousel-control-prev" href="#mainCarousel" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#mainCarousel" role="button" data-slide="next">
                    <span class="carousel-control-next-icon"></span>
                    <span class="sr-only">Next</span>
                </a>

                <a class="carousel-control-prev" href="#mainCarousel" role="button" data-slide="prev"><span class="carousel-control-prev-icon"></span></a>
                <a class="carousel-control-next" href="#mainCarousel" role="button" data-slide="next"><span class="carousel-control-next-icon"></span></a>

            </div>

            <section id="ve-chung-toi" class="about-section container py-5">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h2 class="section-title">VỀ CHÚNG TÔI</h2>
                        <h4>
                            <span class="text-danger">HOME DECOR </span> ĐI ĐẦU XU THẾ NỘI THẤT <br>
                            <span class="text-danger">SANG TRỌNG HIỆN ĐẠI ĐẲNG CẤP</span>
                        </h4>
                        <p>
                            HOME DECOR được thành lập để thiết kế báo cáo bài tập môn học lập trình web. Ở đây chúng tôi sẽ giới thiệu những sản phẩm nội thất thân thuộc với ngôi nhà của bạn.
                            <strong>HOME DECOR</strong> mong muốn được là một trong những đơn vị thiết kế nội thất được yêu thích nhất của bạn.
                            <br><br>
                            Với tiêu chí <strong>“sáng tạo không giới hạn”</strong>, chúng tôi tập trung vào thiết kế bên ngoài và chất lượng bên trong. Mang lại những trải nghiệm tốt nhất cho khách hàng sử dụng sản phẩm của chúng tôi.
                        </p>
                    </div>
                    <div class="col-md-6 text-center">
                        <div class="video-thumbnail position-relative">
                            <img src="~/Content/images/AnhVeChungToi.png" class="img-fluid rounded" alt="About Image">
                            <a href="https://youtu.be/I3piKNJDhGE?si=QK2eJ6Sil5DD-15Q" class="play-button"><i class="fas fa-play"></i></a>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @if (listGiaTot != null && listGiaTot.Any())
        {
            <div class="container mt-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="moho-title-wrap"><h2 class="moho-section-title mb-0">🔥 Giá siêu tốt</h2></div>
                    <a href="/SanPham/DanhMuc?dm=DM04" class="text-danger font-weight-bold">Xem thêm</a>
                </div>

                <div class="row no-gutters">
                    @foreach (var sp in listGiaTot)
                    {
                        int countReview = db.DanhGias.Count(x => x.IdSanPham == sp.IdSanPham);
                        int rating = sp.DanhGia ?? 0;

                        <div class="col-6 col-md-4 col-lg-3 mb-4 px-2">
                            <div class="card h-100 position-relative product-card">
                                @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai.Value > 0 && sp.Gia > 0)
                                {
                                    var discount = Math.Round(100 - (sp.GiaKhuyenMai.Value / sp.Gia * 100));
                                    <span class="discount-badge">-@discount%</span>
                                }

                                <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })">
                                    <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)" class="card-img-top product-img" style="width:100%; height:250px; object-fit:cover; cursor:pointer;" />
                                </a>

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@sp.TenSanPham</h5>
                                    <p class="card-text product-price d-flex align-items-center mb-2">
                                        <span class="text-danger font-weight-bold mr-2">@(sp.GiaKhuyenMai.HasValue ? sp.GiaKhuyenMai.Value.ToString("C0", culture) : "")</span>
                                        <del class="text-muted">@sp.Gia.ToString("C0", culture)</del>
                                    </p>

                                    <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })#danhGia" style="text-decoration:none; color:inherit;">
                                        <div class="rating mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rating)
                                                {<i class="fas fa-star" style="color:#ff9f00; font-size:12px;"></i> }
                                                else
                                                { <i class="far fa-star" style="color:#ccc; font-size:12px;"></i>}
                                            }
                                            <span style="font-size:12px; color:#777;">(@countReview)</span>
                                        </div>
                                    </a>

                                    <div class="d-flex justify-content-end"><span class="sold-text">Đã bán @sp.DaBan</span></div>
                                    <div class="d-flex mt-auto">
                                        <button class="color-btn mr-2" style="background-color:black;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                        <button class="color-btn" style="background-color:white;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (listBanChay != null && listBanChay.Any())
        {
            <div class="container mt-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">Bán chạy</h2>
                    <a href="/SanPham/DanhMuc?dm=DM04" class="text-danger font-weight-bold">Xem thêm</a>
                </div>

                <div class="row no-gutters">
                    @foreach (var sp in listBanChay)
                    {
                        int countReview = db.DanhGias.Count(x => x.IdSanPham == sp.IdSanPham);
                        int rating = sp.DanhGia ?? 0;

                        <div class="col-6 col-md-4 col-lg-3 mb-4 px-2">
                            <div class="card h-100 position-relative product-card">
                                @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai.Value > 0 && sp.Gia > 0)
                                {
                                    var discount = Math.Round(100 - (sp.GiaKhuyenMai.Value / sp.Gia * 100));
                                    <span class="discount-badge">-@discount%</span>
                                }

                                <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })">
                                    <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)" class="card-img-top product-img" style="width:100%; height:250px; object-fit:cover; cursor:pointer;" />
                                </a>

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@sp.TenSanPham</h5>
                                    <p class="card-text product-price d-flex align-items-center mb-2">
                                        @if (sp.GiaKhuyenMai.HasValue)
                                        {
                                            <span class="text-danger font-weight-bold mr-2">@sp.GiaKhuyenMai.Value.ToString("C0", culture)</span>
                                            <del class="text-muted">@sp.Gia.ToString("C0", culture)</del>
                                        }
                                        else
                                        {
                                            <span class="font-weight-bold">@sp.Gia.ToString("C0", culture)</span>
                                        }
                                    </p>

                                    <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })#danhGia" style="text-decoration:none; color:inherit;">
                                        <div class="rating mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rating)
                                                {<i class="fas fa-star" style="color:#ff9f00; font-size:12px;"></i> }
                                                else
                                                { <i class="far fa-star" style="color:#ccc; font-size:12px;"></i>}
                                            }
                                            <span style="font-size:12px; color:#777;">(@countReview)</span>
                                        </div>
                                    </a>

                                    <div class="d-flex justify-content-end"><span class="sold-text">Đã bán @sp.DaBan</span></div>
                                    <div class="d-flex mt-auto">
                                        <button class="color-btn mr-2" style="background-color:black;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                        <button class="color-btn" style="background-color:white;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Gợi ý</h2>
                <a href="/SanPham/DanhMuc?dm=DM04" class="text-danger font-weight-bold">Xem thêm</a>
            </div>
            <div class="row no-gutters">
                @foreach (var sp in Model)
                {
                    int countReview = db.DanhGias.Count(x => x.IdSanPham == sp.IdSanPham);
                    int rating = sp.DanhGia ?? 0;

                    <div class="col-6 col-md-4 col-lg-3 mb-4 px-2">
                        <div class="card h-100 position-relative product-card">
                            @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai.Value > 0 && sp.Gia > 0)
                            {
                                var discount = Math.Round(100 - (sp.GiaKhuyenMai.Value / sp.Gia * 100));
                                <span class="discount-badge">-@discount%</span>
                            }
                            <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })">
                                <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)" class="card-img-top product-img" style="width:100%; height:250px; object-fit:cover; cursor:pointer;" />
                            </a>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@sp.TenSanPham</h5>
                                <p class="card-text product-price d-flex align-items-center mb-2" style="flex-wrap: nowrap; overflow: hidden;">
                                    @if (sp.GiaKhuyenMai.HasValue)
                                    {
                                        <span class="text-danger font-weight-bold mr-2">@sp.GiaKhuyenMai.Value.ToString("C0", culture)</span>
                                        <del class="text-muted">@sp.Gia.ToString("C0", culture)</del>
                                    }
                                    else
                                    {
                                        <span class="font-weight-bold">@sp.Gia.ToString("C0", culture)</span>
                                    }
                                </p>

                                <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })#danhGia" style="text-decoration:none; color:inherit;">
                                    <div class="rating mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= rating)
                                            {<i class="fas fa-star" style="color:#ff9f00; font-size:12px;"></i> }
                                            else
                                            { <i class="far fa-star" style="color:#ccc; font-size:12px;"></i>}
                                        }
                                        <span style="font-size:12px; color:#777;">(@countReview)</span>
                                    </div>
                                </a>

                                <div class="d-flex justify-content-end"><span class="sold-text">Đã bán @sp.DaBan</span></div>
                                <div class="d-flex mt-auto">
                                    <button class="color-btn mr-2" style="background-color:black;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                    <button class="color-btn" style="background-color:white;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <section class="home-banner">
                <div class="banner-item"><img src="~/Content/images/banner1.jpg" alt=""></div>
                <div class="banner-item"><img src="~/Content/images/banner2.jpg" alt=""></div>
                <div class="banner-item"><img src="~/Content/images/banner3.jpg" alt=""></div>
            </section>
        </div>

        @if (listBep != null && listBep.Any())
        {
            <div class="container mt-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">Kitchen</h2>
                    <a href="/SanPham/DanhMuc?dm=DM04" class="text-danger font-weight-bold">Xem thêm</a>
                </div>

                <div class="row no-gutters">
                    @foreach (var sp in listBep)
                    {
                        int countReview = db.DanhGias.Count(x => x.IdSanPham == sp.IdSanPham);
                        int rating = sp.DanhGia ?? 0;

                        <div class="col-6 col-md-4 col-lg-3 mb-4 px-2">
                            <div class="card h-100 position-relative product-card">
                                @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai.Value > 0 && sp.Gia > 0)
                                {
                                    var discount = Math.Round(100 - (sp.GiaKhuyenMai.Value / sp.Gia * 100));
                                    <span class="discount-badge">-@discount%</span>
                                }
                                <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })">
                                    <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)" class="card-img-top product-img" style="width:100%; height:250px; object-fit:cover; cursor:pointer;" />
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@sp.TenSanPham</h5>
                                    <p class="card-text product-price d-flex align-items-center mb-2">
                                        <span class="text-danger font-weight-bold mr-2">
                                            @(sp.GiaKhuyenMai.HasValue ? sp.GiaKhuyenMai.Value.ToString("C0", culture) : sp.Gia.ToString("C0", culture))
                                        </span>
                                        @if (sp.GiaKhuyenMai.HasValue)
                                        {
                                            <del class="text-muted">@sp.Gia.ToString("C0", culture)</del>
                                        }
                                    </p>
                                    <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })#danhGia" style="text-decoration:none; color:inherit;">
                                        <div class="rating mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rating)
                                                {<i class="fas fa-star" style="color:#ff9f00; font-size:12px;"></i> }
                                                else
                                                { <i class="far fa-star" style="color:#ccc; font-size:12px;"></i>}
                                            }
                                            <span style="font-size:12px; color:#777;">(@countReview)</span>
                                        </div>
                                    </a>
                                    <div class="moho-sold">Đã bán @sp.DaBan</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }


