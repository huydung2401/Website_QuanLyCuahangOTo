@model List<TKW.Models.SanPham>
@using System.Globalization
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/css/site.css" />
<!-- Carousel / Banner -->
<div class="container mt-3">
    <div id="mainCarousel" class="carousel slide mx-auto" data-ride="carousel" data-interval="5000">
        <ol class="carousel-indicators">
            <li data-target="#mainCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#mainCarousel" data-slide-to="1"></li>
            <li data-target="#mainCarousel" data-slide-to="2"></li>
            <li data-target="#mainCarousel" data-slide-to="3"></li>
        </ol>

        <div class="carousel-inner text-center">
            <div class="carousel-item active">
                <img src="~/Content/images/carousel02.jpg" class="d-inline-block carousel-img" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel06.jpg" class="d-inline-block carousel-img" alt="Slide 2">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel03.jpg" class="d-inline-block carousel-img" alt="Slide 3">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel04.jpg" class="d-inline-block carousel-img" alt="Slide 4">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel05.jpg" class="d-inline-block carousel-img" alt="Slide 5">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel01.jpg" class="d-inline-block carousel-img" alt="Slide 6">
            </div>
       
        </div>

        <a class="carousel-control-prev" href="#mainCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#mainCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
</div>

<!-- Danh sách sản phẩm -->
<div class="container mt-4">
    <h2 class="mb-4">Tất cả sản phẩm</h2>
    <div class="row no-gutters">
        @foreach (var sp in Model)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-4 px-2">
                <div class="card h-100 position-relative product-card">

                    @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai > 0 && sp.GiaKhuyenMai < sp.Gia)
                    {
                        var discount = Math.Round(100 - (sp.GiaKhuyenMai.Value / sp.Gia * 100));
                        <span class="badge badge-danger position-absolute discount-badge">-@discount%</span>
                    }

                    <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })">
                        <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)"
                             class="card-img-top product-img"
                             alt="@sp.TenSanPham"
                             style="height:200px; object-fit:cover; cursor:pointer;" />
                    </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@sp.TenSanPham</h5>

                        <!-- Giá sản phẩm -->
                        <p class="card-text product-price d-flex align-items-center mb-2" style="flex-wrap: nowrap; overflow: hidden;">
                            @if (sp.GiaKhuyenMai.HasValue)
                            {
                                <span class="text-danger font-weight-bold mr-2" style="flex-shrink:0;">
                                    @sp.GiaKhuyenMai.Value.ToString("C0", new CultureInfo("vi-VN"))
                                </span>
                                <del class="text-muted" style="flex-shrink:0;">
                                    @sp.Gia.ToString("C0", new CultureInfo("vi-VN"))
                                </del>
                            }
                            else
                            {
                                <span class="font-weight-bold" style="flex-shrink:0;">
                                    @sp.Gia.ToString("C0", new CultureInfo("vi-VN"))
                                </span>
                            }
                        </p>

                        <!-- ⭐ Đánh giá sao -->
                        <div class="rating mb-2">
                            @{
                                int rating = sp.DanhGia ?? 0;

                            }
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= rating)
                                {
                                    <i class="fas fa-star" style="color:#ff9f00; font-size:15px;"></i>
                                }
                                else
                                {
                                    <i class="far fa-star" style="color:#ccc; font-size:15px;"></i>
                                }
                            }
                            <span style="font-size:14px; color:#777;">(@rating)</span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <span class="sold-text">Đã bán @sp.DaBan</span>
                        </div>

                        <!-- Chọn màu sắc -->
                        <div class="d-flex mt-auto">
                            <button class="color-btn mr-2" style="background-color:black;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                            <button class="color-btn" style="background-color:white;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                        </div>
                    </div>
                </div>

                <!-- Modal chi tiết -->
                <div class="modal fade" id="productModal-@sp.IdSanPham" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@sp.TenSanPham</h5>
                                <button type="button" class="close" data-dismiss="modal">
                                    <span>&times;</span>
                                </button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)" class="img-fluid mb-3">
                                <p>@sp.MoTaNgan</p>
                                <p class="product-price">
                                    @if (sp.GiaKhuyenMai.HasValue)
                                    {
                                        <strong class="text-danger">@sp.GiaKhuyenMai.Value.ToString("C0", new CultureInfo("vi-VN"))</strong>
                                        <del class="text-muted ml-2">@sp.Gia.ToString("C0", new CultureInfo("vi-VN"))</del>
                                    }
                                    else
                                    {
                                        <strong>@sp.Gia.ToString("C0", new CultureInfo("vi-VN"))</strong>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>


<style>
    <style >
    /* Badge giảm giá */
    .discount-badge {
        top: 10px;
        left: 10px;
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
    }

    /* Nút chọn màu */
    .color-btn {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 1px solid #ccc;
        cursor: pointer;
        transition: all 0.2s;
    }

        .color-btn.active {
            border: 2px solid #000;
        }

    /* Hover ảnh sản phẩm */
    .product-card .product-img:hover {
        opacity: 0.9;
    }

    /* Tên sản phẩm và giá mặc định */
    .product-card .card-title {
        font-size: 1rem;
        font-weight: 600;
    }

    .product-card .product-price {
        font-size: 0.9rem;
    }

    /* Responsive: khi màn hình nhỏ */

    .sold-text {
        font-size: 14px;
        color: #777;
    }

    .color-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 1px solid #bbb;
        display: inline-block;
    }


</style>


<script>
    $(document).ready(function () {
        // Chọn màu
        $('.color-btn').click(function () {
            $(this).siblings().removeClass('active');
            $(this).addClass('active');
            var imgUrl = $(this).data('img');
            $(this).closest('.card').find('.product-img').attr('src', imgUrl);
        });
    });
</script>
