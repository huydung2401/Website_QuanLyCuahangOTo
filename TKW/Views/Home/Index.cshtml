<div class="container mt-5">
    <h2 class="section-title">Báo chí</h2>
    <div class="news-slider-wrapper">
        <div class="news-slider">
            <div class="news-track">
                <div class="news-item"><img src="~/Content/images/news1.png" /><h4>[Advertising Vietnam] MOHO – Made in Việt Nam...</h4><a class="more-link" href="#">Xem thêm</a></div>
                <div class="news-item"><img src="~/Content/images/news2.png" /><h4>[Công Thương] Nội thất MOHO gia nhập thị trường...</h4><a class="more-link" href="#">Xem thêm</a></div>
                <div class="news-item"><img src="~/Content/images/news3.png" /><h4>[VnExpress] Thương hiệu Nội thất MOHO...</h4><a class="more-link" href="#">Xem thêm</a></div>
                <div class="news-item"><img src="~/Content/images/news4.png" /><h4>[VnExpress] Thương hiệu Nội thất MOHO...</h4><a class="more-link" href="#">Xem thêm</a></div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h2 class="section-title">Khách hàng MOHO tại</h2>
    <div class="brand-slider-wrapper">
        <div class="brand-track">
            <div class="brand-item"><img src="~/Content/images/logo1.png" /></div>
            <div class="brand-item"><img src="~/Content/images/logo2.png" /></div>
            <div class="brand-item"><img src="~/Content/images/logo3.png" /></div>
            <div class="brand-item"><img src="~/Content/images/logo4.png" /></div>
            <div class="brand-item"><img src="~/Content/images/logo5.png" /></div>
            <div class="brand-item"><img src="~/Content/images/logo6.png" /></div>
            <div class="brand-item clone"><img src="~/Content/images/logo1.png" /></div>
            <div class="brand-item clone"><img src="~/Content/images/logo2.png" /></div>
            <div class="brand-item clone"><img src="~/Content/images/logo3.png" /></div>
            <div class="brand-item clone"><img src="~/Content/images/logo4.png" /></div>
            <div class="brand-item clone"><img src="~/Content/images/logo5.png" /></div>
