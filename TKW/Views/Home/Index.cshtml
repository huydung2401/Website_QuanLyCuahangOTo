@model List<TKW.Models.SanPham>
@using System.Globalization

<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<link rel="stylesheet" href="~/Content/css/site.css" />

<!-- =========================
     🔹 CAROUSEL / BANNER FULL WIDTH
========================= -->
<div class="carousel-wrapper mt-3">
    <div id="mainCarousel" class="carousel slide carousel-fade" data-ride="carousel" data-interval="3000">
        <ol class="carousel-indicators">
            <li data-target="#mainCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#mainCarousel" data-slide-to="1"></li>
            <li data-target="#mainCarousel" data-slide-to="2"></li>
            <li data-target="#mainCarousel" data-slide-to="3"></li>
        </ol>

        <div class="carousel-inner text-center">
            <div class="carousel-item active">
                <img src="~/Content/images/carousel02.jpg" class="d-block w-100 carousel-img" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel06.jpg" class="d-block w-100 carousel-img" alt="Slide 2">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel03.jpg" class="d-block w-100 carousel-img" alt="Slide 3">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel04.jpg" class="d-block w-100 carousel-img" alt="Slide 4">
            </div>
            <div class="carousel-item">
                <img src="~/Content/images/carousel05.jpg" class="d-block w-100 carousel-img" alt="Slide 5">
            </div>
        </div>

        <!-- Nút điều hướng -->
        <a class="carousel-control-prev" href="#mainCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#mainCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
</div>



@if (ViewBag.GiaTot != null)
{
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="moho-title-wrap">
                <h2 class="moho-section-title mb-0">🔥 Giá siêu tốt</h2>
            </div>

            <a href="/SanPham/DanhMuc?dm=DM04" class="moho-more">Xem thêm</a>
        </div>



        <div class="row no-gutters">

            @foreach (var sp in ViewBag.GiaTot)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4 px-2">
                    <div class="card h-100 position-relative product-card">

                        <!-- Badge giảm giá -->
                        @if (sp.GiaKhuyenMai > 0 && sp.GiaKhuyenMai < sp.Gia)
                        {
                            var discount = Math.Round(100 - (sp.GiaKhuyenMai / sp.Gia * 100));
                            <span class="discount-badge">-@discount%</span>
                        }

                        <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = sp.IdSanPham })">
                            <img src="@Url.Content("~/Content/images/" + sp.HinhAnh)"
                                 class="card-img-top product-img"
                                 style="width:100%; height:250px; object-fit:cover; cursor:pointer;" />
                        </a>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@sp.TenSanPham</h5>

                            <!-- Giá -->
                            <p class="card-text product-price d-flex align-items-center mb-2">
                                <span class="text-danger font-weight-bold mr-2">
                                    @sp.GiaKhuyenMai.ToString("C0", new CultureInfo("vi-VN"))
                                </span>
                                <del class="text-muted">
                                    @sp.Gia.ToString("C0", new CultureInfo("vi-VN"))
                                </del>
                            </p>

                            <!-- ⭐ Đánh giá sao -->
                            <div class="rating mb-2">
                                @{
                                    int rating = sp.DanhGia ?? 0;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= rating)
                                    {
                                        <i class="fas fa-star" style="color:#ff9f00; font-size:15px;"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star" style="color:#ccc; font-size:15px;"></i>
                                    }
                                }
                                <span style="font-size:14px; color:#777;">(@rating)</span>
                            </div>

                            <!-- Đã bán -->
                            <div class="d-flex justify-content-end">
                                <span class="sold-text">Đã bán @sp.DaBan</span>
                            </div>

                            <!-- Chọn màu sắc -->
                            <div class="d-flex mt-auto">
                                <button class="color-btn mr-2" style="background-color:black;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                                <button class="color-btn" style="background-color:white;" data-img="@Url.Content("~/Content/images/" + sp.HinhAnh)"></button>
                            </div>
                        </div>

                    </div>
                </div>
            }

        </div>
    </div>
}


