<form action="@Url.Action("Index", "Home")" method="GET" id="filterForm">
    <div class="container carmudi-container mt-4">
        <div class="search-box-wrapper shadow-sm p-3 rounded d-flex align-items-center position-relative">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="liveSearch"
                   name="tuKhoa"
                   class="search-input"
                   value="@ViewBag.CurrentTuKhoa"
                   placeholder="Tìm kiếm theo Hãng xe, Dòng xe hoặc Từ khóa...">

            <button type="submit" style="display:none"></button>

            <!-- KẾT QUẢ LIVE -->
            <div id="searchResult" class="search-result-box"></div>
        </div>
    </div>

    <!-- BỘ LỌC + DANH SÁCH XE -->
    <div class="container carmudi-container mt-4">
        <div class="row">

            <!-- ======== BỘ LỌC (SIDEBAR) ======== -->
            <div class="col-md-3">
                <aside class="filter-panel">

                    <div class="filter-header d-flex justify-content-between">
                        <span>Bộ lọc</span>
                        <a href="@Url.Action("Index","Home")" style="font-size:12px; color:red; line-height:22px; text-decoration:none;">Xóa lọc</a>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-building"></i></span>
                            <span class="filter-label">Hãng xe</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list" style="max-height:300px; overflow-y:auto;">
                                @if (ViewBag.ListHangXe != null)
                                {
                                    foreach (var hang in (List<TKW.Models.HangXe>)ViewBag.ListHangXe)
                                    {
                                        <li>
                                            <input type="checkbox" name="hangXe" value="@hang.IdHangXe"
                                                   onchange="this.form.submit()"
                                                   @(Request.QueryString["hangXe"] != null && Request.QueryString["hangXe"].Contains(hang.IdHangXe) ? "checked" : "")>
                                            &nbsp; @hang.TenHang
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-map-marker-alt"></i></span>
                            <span class="filter-label">Địa điểm</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="diaDiem" value="Hà Nội" onchange="this.form.submit()" @(Request.QueryString["diaDiem"] != null && Request.QueryString["diaDiem"].Contains("Hà Nội") ? "checked" : "")> Hà Nội</li>
                                <li><input type="checkbox" name="diaDiem" value="Hồ Chí Minh" onchange="this.form.submit()" @(Request.QueryString["diaDiem"] != null && Request.QueryString["diaDiem"].Contains("Hồ Chí Minh") ? "checked" : "")> TP. Hồ Chí Minh</li>
                                <li><input type="checkbox" name="diaDiem" value="Đà Nẵng" onchange="this.form.submit()" @(Request.QueryString["diaDiem"] != null && Request.QueryString["diaDiem"].Contains("Đà Nẵng") ? "checked" : "")> Đà Nẵng</li>
                                <li><input type="checkbox" name="diaDiem" value="Cần Thơ" onchange="this.form.submit()" @(Request.QueryString["diaDiem"] != null && Request.QueryString["diaDiem"].Contains("Cần Thơ") ? "checked" : "")> Cần Thơ</li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-wallet"></i></span>
                            <span class="filter-label">Giá</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="mucGia" value="0-300" onchange="this.form.submit()" @(Request.QueryString["mucGia"] != null && Request.QueryString["mucGia"].Contains("0-300") ? "checked" : "")> Dưới 300 triệu</li>
                                <li><input type="checkbox" name="mucGia" value="300-500" onchange="this.form.submit()" @(Request.QueryString["mucGia"] != null && Request.QueryString["mucGia"].Contains("300-500") ? "checked" : "")> 300 - 500 triệu</li>
                                <li><input type="checkbox" name="mucGia" value="500-800" onchange="this.form.submit()" @(Request.QueryString["mucGia"] != null && Request.QueryString["mucGia"].Contains("500-800") ? "checked" : "")> 500 - 800 triệu</li>
                                <li><input type="checkbox" name="mucGia" value="800-1200" onchange="this.form.submit()" @(Request.QueryString["mucGia"] != null && Request.QueryString["mucGia"].Contains("800-1200") ? "checked" : "")> 800 - 1.2 tỷ</li>
                                <li><input type="checkbox" name="mucGia" value="1200-max" onchange="this.form.submit()" @(Request.QueryString["mucGia"] != null && Request.QueryString["mucGia"].Contains("1200-max") ? "checked" : "")> Trên 1.2 tỷ</li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-calendar-alt"></i></span>
                            <span class="filter-label">Năm sản xuất</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <div class="year-slider-box">
                                <div class="slider-track"></div>
                                <input type="range" id="year-min" min="2000" max="2025" value="@(ViewBag.CurrentNamMin ?? 2000)">
                                <input type="range" id="year-max" min="2000" max="2025" value="@(ViewBag.CurrentNamMax ?? 2025)">

                                <input type="hidden" name="namMin" id="real-year-min" value="@ViewBag.CurrentNamMin">
                                <input type="hidden" name="namMax" id="real-year-max" value="@ViewBag.CurrentNamMax">
                            </div>
                            <div class="year-values">
                                <div class="year-box"><label>Tối thiểu</label><input type="text" id="year-min-value" readonly></div>
                                <div class="year-box"><label>Tối đa</label><input type="text" id="year-max-value" readonly></div>
                            </div>
                            <button type="button" onclick="this.form.submit()" class="btn btn-primary btn-sm btn-block mt-3" style="border-radius:20px; width:100%;">Lọc Năm</button>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-road"></i></span>
                            <span class="filter-label">Số KM</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="soKm" value="0-5000" onchange="this.form.submit()" @(Request.QueryString["soKm"] != null && Request.QueryString["soKm"].Contains("0-5000") ? "checked" : "")> Dưới 5.000 km</li>
                                <li><input type="checkbox" name="soKm" value="5000-20000" onchange="this.form.submit()" @(Request.QueryString["soKm"] != null && Request.QueryString["soKm"].Contains("5000-20000") ? "checked" : "")> 5k - 20k km</li>
                                <li><input type="checkbox" name="soKm" value="20000-50000" onchange="this.form.submit()" @(Request.QueryString["soKm"] != null && Request.QueryString["soKm"].Contains("20000-50000") ? "checked" : "")> 20k - 50k km</li>
                                <li><input type="checkbox" name="soKm" value="50000-100000" onchange="this.form.submit()" @(Request.QueryString["soKm"] != null && Request.QueryString["soKm"].Contains("50000-100000") ? "checked" : "")> 50k - 100k km</li>
                                <li><input type="checkbox" name="soKm" value="100000-max" onchange="this.form.submit()" @(Request.QueryString["soKm"] != null && Request.QueryString["soKm"].Contains("100000-max") ? "checked" : "")> Trên 100k km</li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-car-side"></i></span>
                            <span class="filter-label">Kiểu dáng</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="kieuDang" value="Sedan" onchange="this.form.submit()" @(Request.QueryString["kieuDang"] != null && Request.QueryString["kieuDang"].Contains("Sedan") ? "checked" : "")> Sedan</li>
                                <li><input type="checkbox" name="kieuDang" value="SUV" onchange="this.form.submit()" @(Request.QueryString["kieuDang"] != null && Request.QueryString["kieuDang"].Contains("SUV") ? "checked" : "")> SUV</li>
                                <li><input type="checkbox" name="kieuDang" value="Hatchback" onchange="this.form.submit()" @(Request.QueryString["kieuDang"] != null && Request.QueryString["kieuDang"].Contains("Hatchback") ? "checked" : "")> Hatchback</li>
                                <li><input type="checkbox" name="kieuDang" value="Pickup" onchange="this.form.submit()" @(Request.QueryString["kieuDang"] != null && Request.QueryString["kieuDang"].Contains("Pickup") ? "checked" : "")> Pickup</li>
                                <li><input type="checkbox" name="kieuDang" value="Coupe" onchange="this.form.submit()" @(Request.QueryString["kieuDang"] != null && Request.QueryString["kieuDang"].Contains("Coupe") ? "checked" : "")> Coupe</li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-gas-pump"></i></span>
                            <span class="filter-label">Nhiên liệu</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="nhienLieu" value="Xăng" onchange="this.form.submit()" @(Request.QueryString["nhienLieu"] != null && Request.QueryString["nhienLieu"].Contains("Xăng") ? "checked" : "")> Xăng</li>
                                <li><input type="checkbox" name="nhienLieu" value="Dầu" onchange="this.form.submit()" @(Request.QueryString["nhienLieu"] != null && Request.QueryString["nhienLieu"].Contains("Dầu") ? "checked" : "")> Dầu</li>
                                <li><input type="checkbox" name="nhienLieu" value="Hybrid" onchange="this.form.submit()" @(Request.QueryString["nhienLieu"] != null && Request.QueryString["nhienLieu"].Contains("Hybrid") ? "checked" : "")> Hybrid</li>
                                <li><input type="checkbox" name="nhienLieu" value="Điện" onchange="this.form.submit()" @(Request.QueryString["nhienLieu"] != null && Request.QueryString["nhienLieu"].Contains("Điện") ? "checked" : "")> Điện</li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-cogs"></i></span>
                            <span class="filter-label">Hộp số</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li>
                                    <input type="radio" name="hopSo" value="Tự động"
                                           onchange="this.form.submit()"
                                           @(Request.QueryString["hopSo"] == "Tự động" ? "checked" : "")>
                                    Số tự động
                                </li>

                                <li>
                                    <input type="radio" name="hopSo" value="Số sàn"
                                           onchange="this.form.submit()"
                                           @(Request.QueryString["hopSo"] == "Số sàn" ? "checked" : "")>
                                    Số sàn
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-palette"></i></span>
                            <span class="filter-label">Màu sắc</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="mauSac" value="Trang" onchange="this.form.submit()" @(Request.QueryString["mauSac"] != null && Request.QueryString["mauSac"].Contains("Trang") ? "checked" : "")> Trắng</li>
                                <li><input type="checkbox" name="mauSac" value="Den" onchange="this.form.submit()" @(Request.QueryString["mauSac"] != null && Request.QueryString["mauSac"].Contains("Den") ? "checked" : "")> Đen</li>
                                <li><input type="checkbox" name="mauSac" value="Do" onchange="this.form.submit()" @(Request.QueryString["mauSac"] != null && Request.QueryString["mauSac"].Contains("Do") ? "checked" : "")> Đỏ</li>
                                <li><input type="checkbox" name="mauSac" value="Bac" onchange="this.form.submit()" @(Request.QueryString["mauSac"] != null && Request.QueryString["mauSac"].Contains("Bac") ? "checked" : "")> Bạc</li>
                                <li><input type="checkbox" name="mauSac" value="Xanh" onchange="this.form.submit()" @(Request.QueryString["mauSac"] != null && Request.QueryString["mauSac"].Contains("Xanh") ? "checked" : "")> Xanh</li>
                            </ul>
                        </div>
                    </div>

                    <div class="filter-group">
                        <button type="button" class="filter-row filter-toggle-btn">
                            <span class="filter-icon"><i class="fas fa-user-circle"></i></span>
                            <span class="filter-label">Đăng bởi</span>
                            <span class="filter-toggle"><i class="fas fa-chevron-down"></i></span>
                        </button>
                        <div class="filter-content">
                            <ul class="filter-list">
                                <li><input type="checkbox" name="dangBoi" value="CaNhan" onchange="this.form.submit()" @(Request.QueryString["dangBoi"] != null && Request.QueryString["dangBoi"].Contains("CaNhan") ? "checked" : "")> Cá nhân</li>
                                <li><input type="checkbox" name="dangBoi" value="Salon" onchange="this.form.submit()" @(Request.QueryString["dangBoi"] != null && Request.QueryString["dangBoi"].Contains("Salon") ? "checked" : "")> Salon</li>
                            </ul>
                        </div>
                    </div>

                </aside>
            </div>
            <div class="col-md-9">
                <div class="container banner-small">

                    <div id="mainCarousel" class="carousel slide carousel-fade" data-ride="carousel" data-interval="2000">

                        <!-- Indicators -->
                        <ol class="carousel-indicators">
                            <li data-target="#mainCarousel" data-slide-to="0" class="active"></li>
                            <li data-target="#mainCarousel" data-slide-to="1"></li>
                            <li data-target="#mainCarousel" data-slide-to="2"></li>
                            <li data-target="#mainCarousel" data-slide-to="3"></li>
                            <li data-target="#mainCarousel" data-slide-to="4"></li>
                        </ol>

                        <!-- Slides -->
                        <div class="carousel-inner text-center">
                            <div class="carousel-item active">
                                <img src="~/Content/images/cta-bg.jpg" class="d-block w-100 carousel-img" alt="Slide 1">
                            </div>

                            <div class="carousel-item">
                                <img src="~/Content/images/background01.jpg" class="d-block w-100 carousel-img" alt="Slide 2">
                            </div>

                            <div class="carousel-item">
                                <img src="~/Content/images/background02.jpg" class="d-block w-100 carousel-img" alt="Slide 3">
                            </div>

                            <div class="carousel-item">
                                <img src="~/Content/images/background03.jpg" class="d-block w-100 carousel-img" alt="Slide 4">
                            </div>

                            <div class="carousel-item">
                                <img src="~/Content/images/background04.jpg" class="d-block w-100 carousel-img" alt="Slide 5">
                            </div>
                        </div>

                        <!-- Điều hướng -->
                        <a class="carousel-control-prev" href="#mainCarousel" role="button" data-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </a>

                        <a class="carousel-control-next" href="#mainCarousel" role="button" data-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </a>

                    </div>

                </div>
            </div>


            @functions {
                string FormatGia(decimal gia)
                {
                    // giá tính bằng VND
                    long vnd = (long)gia;

                    // Nếu giá dưới 1 tỷ
                    if (vnd < 1_000_000_000)
                    {
                        long trieu = vnd / 1_000_000;
                        return $"{trieu:N0} triệu";
                    }

                    // Nếu giá từ 1 tỷ trở lên
                    long ty = vnd / 1_000_000_000;
                    long trieuConLai = (vnd % 1_000_000_000) / 1_000_000;

                    if (trieuConLai > 0)
                        return $"{ty} tỷ {trieuConLai:N0} triệu";

                    return $"{ty} tỷ";
                }
            }


            <!-- ======== DANH SÁCH XE ======== -->
            <div class="col-md-12">

                <h4 class="car-list-title">Mua bán ô tô - Xe ô tô cũ - Xe hơi toàn quốc</h4>
                <p class="car-list-sub">
                    Có 3453 tin bán xe giá từ 75 triệu đến 15 tỷ 990 triệu (cập nhật mới nhất 11/2025)
                </p>

                <!-- ===== ROW CHÍNH – 4 CỘT ===== -->
                <div class="row g-4">
                    @foreach (var xe in Model)
                    {
                        var img = xe.XeHinhAnhs.FirstOrDefault()?.HinhAnh ?? "no-image.jpg";

                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">

                            <a href="@Url.Action("ChiTietXe","Xe", new { id = xe.IdXe })" class="card-link-wrapper">
                                <div class="car-card-carmudi">

                                    <div class="car-img-wrap">
                                        <img src="@Url.Content("~/Content/images/" + img)" class="car-img-carmudi" />
                                    </div>

                                    <div class="car-body-carmudi">

                                        <h5 class="car-name">@xe.TieuDe</h5>


                                        <div class="car-info-row">
                                            <div class="car-info-item"><i class="fas fa-calendar"></i> <span>No data</span></div>
                                            <div class="car-info-item"><i class="fas fa-road"></i> <span>Xe mới</span></div>
                                        </div>

                                        <div class="car-info-row">
                                            <div class="car-info-item"><i class="fas fa-gas-pump"></i> <span>@xe.NhienLieu</span></div>
                                            <div class="car-info-item"><i class="fas fa-cogs"></i> <span>@xe.HopSo</span></div>
                                        </div>

                                        <div class="car-price-carmudi">@FormatGia(xe.Gia)</div>

                                        <div class="car-location">
                                            <i class="fas fa-map-marker-alt"></i> @xe.DiaDiem
                                        </div>

                                    </div>
                                </div>
                            </a>

                        </div>
                    }
                </div>



            </div> <!-- END col-md-9 -->
            <div class="container carmudi-container">
                <div class="car-section">
                    <h2 class="title">XE MỚI VỀ</h2>
                    <div class="swiper carSwiper">
                        <div class="swiper-wrapper">

                            @if (ViewBag.XeMoi != null)
                            {
                                foreach (var item in (List<TKW.Models.Xe>)ViewBag.XeMoi)
                                {
                                    var logoHang = item.HangXe?.TenHang?.ToUpper() ?? "HÃNG XE";
                                    var gia = item.Gia;



                                    <div class="swiper-slide">
                                        <a href="@Url.Action("ChiTietXe","Xe", new { id = item.IdXe })"
                                           class="card-link-wrapper">

                                            <div class="car-card-carmudi car-card-full">

                                                <div class="car-img-wrap">
                                                    <img src="@Url.Content("~/Content/images/" + (item.XeHinhAnhs.FirstOrDefault()?.HinhAnh ?? "no-image.jpg"))"
                                                         class="car-img-carmudi" />
                                                </div>

                                                <div class="car-body-carmudi">

                                                    <div class="d-flex align-items-center mb-1">
                                                        <span class="hang-tag">@logoHang</span>
                                                        <span class="year-tag">@item.NamSX</span>
                                                    </div>

                                                    <h5 class="car-name">@item.TieuDe</h5>

                                                    <div class="car-info-row">
                                                        <span><i class="fas fa-gas-pump"></i> @item.NhienLieu</span>
                                                        <span><i class="fas fa-cogs"></i> @item.HopSo</span>
                                                    </div>

                                                    <div class="car-price">
                                                        @FormatGia(item.Gia)
                                                    </div>

                                                    <div class="car-location">
                                                        <i class="fas fa-map-marker-alt"></i> @item.DiaDiem
                                                    </div>

                                                </div>
                                            </div>

                                        </a>
                                    </div>

                                }
                            }

                        </div>

                        <div class="swiper-pagination"></div>
                    </div>

                    <div class="center-btn">
                        <a href="/Home/Index" class="view-all-btn">Xem tất cả →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
</form>
<script>
    const input = document.getElementById("liveSearch");
    const box = document.getElementById("searchResult");

    // DATA XE TỪ SERVER (Model)
    const cars = [
    @foreach (var xe in Model)
    {
        var img = xe.XeHinhAnhs.FirstOrDefault()?.HinhAnh ?? "no-image.jpg";
        <text>
        {
            id: "@xe.IdXe",
            title: "@xe.TieuDe",
            hang: "@xe.HangXe.TenHang",
            dong: "@xe.DongXe.TenDong",
            price: "@FormatGia(xe.Gia)",
            img: "@Url.Content("~/Content/images/" + img)"
        },
        </text>
    }
    ];

    function removeDiacritics(str) {
        return str.normalize("NFD")
                  .replace(/[\u0300-\u036f]/g, "")
                  .toLowerCase();
    }

    input.addEventListener("input", function () {

        const keyword = removeDiacritics(this.value.trim());
        box.innerHTML = "";

        if (keyword.length === 0) {
            box.style.display = "none";
            return;
        }

        const results = cars.filter(c =>
            removeDiacritics(c.title + " " + c.hang + " " + c.dong)
                .includes(keyword)
        ).slice(0, 8);

        if (results.length === 0) {
            box.innerHTML = `<div class="p-3 text-muted">Không tìm thấy xe</div>`;
            box.style.display = "block";
            return;
        }

        results.forEach(c => {
            box.innerHTML += `
                <div class="search-item"
                     onclick="location.href='/Xe/ChiTietXe/${c.id}'">
                    <img src="${c.img}">
                    <div>
                        <div class="title">${c.title}</div>
                        <div class="price">${c.price}</div>
                    </div>
                </div>
            `;
        });

        box.style.display = "block";
    });

    // Click ra ngoài thì ẩn
    document.addEventListener("click", e => {
        if (!e.target.closest(".search-box-wrapper")) {
            box.style.display = "none";
        }
    });


    var swiper = new Swiper(".carSwiper", {
        slidesPerView: 4,
        spaceBetween: 20,
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        breakpoints: {
            1200: { slidesPerView: 4 },
            992: { slidesPerView: 3 },
            768: { slidesPerView: 2 },
            576: { slidesPerView: 1 }
        }
    });



    // Slider Năm
    const minRange = document.getElementById("year-min");
    const maxRange = document.getElementById("year-max");
    const realMin = document.getElementById("real-year-min");
    const realMax = document.getElementById("real-year-max");

    function updateYearSlider() {
        let min = parseInt(minRange.value);
        let max = parseInt(maxRange.value);
        if (min > max - 1) { minRange.value = max - 1; min = max - 1; }
        if (max < min + 1) { maxRange.value = min + 1; max = min + 1; }
        document.getElementById("year-min-value").value = min;
        document.getElementById("year-max-value").value = max;
        realMin.value = min; realMax.value = max;

        const percent1 = ((min - 2000) / 25) * 100;
        const percent2 = ((max - 2000) / 25) * 100;
        document.querySelector(".slider-track").style.background = `linear-gradient(to right, #d7d7d7 ${percent1}%, #1b66d1 ${percent1}%, #1b66d1 ${percent2}%, #d7d7d7 ${percent2}%)`;
    }

    minRange.addEventListener("input", updateYearSlider);
    maxRange.addEventListener("input", updateYearSlider);
    updateYearSlider();

    document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll(".filter-toggle-btn").forEach(btn => {

            btn.addEventListener("click", e => {
                e.preventDefault();

                const group = btn.closest(".filter-group");
                const content = group.querySelector(".filter-content");
                const icon = group.querySelector(".filter-toggle i");

                // Đóng các filter khác
                document.querySelectorAll(".filter-group.open").forEach(g => {
                    if (g !== group) {
                        g.classList.remove("open");
                        g.querySelector(".filter-content").style.display = "none";
                        g.querySelector(".filter-toggle i").classList.remove("rotated");
                    }
                });

                // Toggle filter hiện tại
                const open = group.classList.toggle("open");
                content.style.display = open ? "block" : "none";
                icon.classList.toggle("rotated", open);
            });

        });

        // ⛔ CHẶN CLICK TRONG FILTER-CONTENT LÀM ĐÓNG
        document.querySelectorAll(".filter-content").forEach(c => {
            c.addEventListener("click", e => e.stopPropagation());
        });

    });
</script>

