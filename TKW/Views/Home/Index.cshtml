<script>
    var swiper = new Swiper(".carSwiper", {
        slidesPerView: 4,
        spaceBetween: 20,
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        breakpoints: {
            1200: { slidesPerView: 4 },
            992: { slidesPerView: 3 },
            768: { slidesPerView: 2 },
            576: { slidesPerView: 1 }
        }
    });

    // nam san xuat slider
    document.querySelectorAll('.filter-toggle-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const parent = btn.closest('.filter-group');
            parent.classList.toggle('active');
        });
    });
    const minRange = document.getElementById("year-min");
    const maxRange = document.getElementById("year-max");

    const minValue = document.getElementById("year-min-value");
    const maxValue = document.getElementById("year-max-value");

    function updateYearSlider() {
        let min = parseInt(minRange.value);
        let max = parseInt(maxRange.value);

        if (min > max - 1) {
            minRange.value = max - 1;
            min = max - 1;
        }

        if (max < min + 1) {
            maxRange.value = min + 1;
            max = min + 1;
        }

        minValue.value = min;
        maxValue.value = max;

        updateTrackFill();
    }

    function updateTrackFill() {
        const track = document.querySelector(".slider-track");
        const min = minRange.value;
        const max = maxRange.value;

        const percent1 = ((min - 2000) / (2025 - 2000)) * 100;
        const percent2 = ((max - 2000) / (2025 - 2000)) * 100;

        track.style.background = `linear-gradient(to right,
        #d7d7d7 ${percent1}%,
        #1b66d1 ${percent1}%,
        #1b66d1 ${percent2}%,
        #d7d7d7 ${percent2}%)`;
    }

    minRange.addEventListener("input", updateYearSlider);
    maxRange.addEventListener("input", updateYearSlider);

    updateYearSlider();


    // an hien filter

    // ĐÓNG/MỞ TỪNG FILTER – CHỈ 1 CÁI ĐƯỢC MỞ
    document.querySelectorAll(".filter-toggle-btn").forEach(btn => {

        btn.addEventListener("click", function () {

            const currentGroup = this.closest(".filter-group");
            const currentContent = currentGroup.querySelector(".filter-content");

            // đóng tất cả group khác
            document.querySelectorAll(".filter-group").forEach(group => {
                if (group !== currentGroup) {
                    group.classList.remove("open");
                    group.querySelector(".filter-content").style.display = "none";
                    group.querySelector(".filter-toggle i").classList.remove("rotated");
                }
            });

            // toggle group đang bấm
            const isOpen = currentGroup.classList.contains("open");

            if (isOpen) {
                currentGroup.classList.remove("open");
                currentContent.style.display = "none";
                this.querySelector(".filter-toggle i").classList.remove("rotated");
            } else {
                currentGroup.classList.add("open");
                currentContent.style.display = "block";
                this.querySelector(".filter-toggle i").classList.add("rotated");
            }

        });

    });

</script>

<style>
    /* ==== KHỐI FILTER COLLAPSE ==== */
    .filter-group {
        margin-bottom: 10px;
    }

    .filter-row {
        width: 100%;
        background: none;
        border: none;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        color: #1d3557;
    }

        .filter-row:hover {
            background: #f5f8ff;
        }

    .filter-content {
        display: none;
        padding: 15px 20px 25px;
        border-top: 1px solid #eee;
    }

        .filter-content.active {
            display: block;
        }

    /* ==== SLIDER BOX ==== */
    .year-slider-box {
        position: relative;
        height: 40px;
        margin-top: 10px;
    }

    /* Track mờ */
    .slider-track {
        position: absolute;
        width: 100%;
        height: 6px;
        background: #ddd;
        border-radius: 4px;
        top: 50%;
        transform: translateY(-50%);
    }

    /* ==== INPUT RANGE ==== */
    .year-slider-box input[type=range] {
        position: absolute;
        width: 100%;
        height: 6px;
        top: 50%;
        transform: translateY(-50%);
        -webkit-appearance: none;
        background: none;
        pointer-events: none; /* để 2 cái overlap */
    }

    /* Track của input bị ẩn */
    input[type=range]::-webkit-slider-runnable-track {
        height: 6px;
        background: none;
    }

    /* NÚT TRÒN */
    input[type=range]::-webkit-slider-thumb {
        -webkit-appearance: none;
        height: 20px;
        width: 20px;
        background: #1a73e8;
        border-radius: 50%;
        cursor: pointer;
        pointer-events: auto;
        box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        margin-top: -7px;
    }

    /* ==== VÙNG ĐÃ CHỌN (MÀU XANH) ==== */
    .slider-track::before {
        content: "";
        position: absolute;
        height: 6px;
        background: linear-gradient(90deg, #005bea, #00c6fb);
        border-radius: 4px;
        top: 0;
        left: 0;
        width: 0%;
    }

    .year-slider-box.active .slider-track::before {
        transition: width 0.15s ease;
    }

    /* ==== KHUNG HIỂN THỊ GIÁ TRỊ ==== */
    .year-values {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .year-box label {
        font-size: 14px;
        color: #8d99ae;
    }

    .year-box input {
        width: 120px;
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        padding: 10px 0;
        border: 1px solid #d8d8d8;
        background: #fff;
        border-radius: 10px;
        margin-top: 5px;
        color: #1d3557;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    /* ================= YEAR SLIDER ================= */

    .year-slider-box {
        position: relative;
        height: 35px;
        margin: 15px 10px 10px 10px;
    }

        .year-slider-box input[type=range] {
            position: absolute;
