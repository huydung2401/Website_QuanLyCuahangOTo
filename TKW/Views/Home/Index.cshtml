        @functions {
            string FormatGia(decimal gia)
            {
                // giá tính bằng VND
                long vnd = (long)gia;

                // Nếu giá dưới 1 tỷ
                if (vnd < 1_000_000_000)
                {
                    long trieu = vnd / 1_000_000;
                    return $"{trieu:N0} triệu";
                }

                // Nếu giá từ 1 tỷ trở lên
                long ty = vnd / 1_000_000_000;
                long trieuConLai = (vnd % 1_000_000_000) / 1_000_000;

                if (trieuConLai > 0)
                    return $"{ty} tỷ {trieuConLai:N0} triệu";

                return $"{ty} tỷ";
            }
        }


