@model TKW.Models.ChiTietSanPham
@{
    ViewBag.Title = Model.SanPham.TenSanPham;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --moho-primary: #003c58;
        --moho-accent: #e8591c;
        --moho-brown: #d4a574;
        --moho-gray: #666;
        --moho-border: #e5e5e5;
        --moho-bg: #f9f9f9;
    }

    /* ===== Breadcrumb ===== */
    nav[aria-label="breadcrumb"] {
        background: #f8f9fa;
        padding: 8px 0;
        border-top: 1px solid #eee;
        border-bottom: 1px solid #eee;
        margin-bottom: 25px;
    }

    .breadcrumb {
        margin-bottom: 0;
        background: none;
        font-size: 15px;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "/";
        color: #999;
        padding: 0 6px;
    }

    .breadcrumb-item a {
        color: #007bff;
        text-decoration: none;
    }

    .breadcrumb-item a:hover {
        text-decoration: underline;
    }

    /* ===== Product Layout ===== */
    .product-detail {
        display: flex;
        gap: 30px;
        align-items: flex-start;
        margin-bottom: 60px;
    }

    /* ===== Left Gallery ===== */
    .gallery-column {
        width: 90px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .gallery-column img {
        width: 100%;
        height: 90px;
        border: 2px solid transparent;
        border-radius: 5px;
        object-fit: cover;
        cursor: pointer;
        transition: 0.3s;
    }

    .gallery-column img.active,
    .gallery-column img:hover {
        border-color: var(--moho-brown);
    }

    .main-image {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

    .main-image img {
        width: 100%;
        height: 600px;
        object-fit: cover;
    }

    /* ===== Product Info ===== */
    .product-info {
        flex: 1;
        padding-left: 20px;
    }

    .product-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .product-meta {
        font-size: 14px;
        color: #888;
        margin-bottom: 15px;
    }



    /* ===== Price Box (Chuẩn Moho, có 2 gạch trên dưới) ===== */
    .price-box {
        padding: 15px 0;
        margin-bottom: 25px;
        border-top: 1px solid #e5e5e5;
        border-bottom: 1px solid #e5e5e5;
    }

    .price-inner {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    /* Nền xám nhạt + chữ cam */
    .discount-tag {
        background: #eeeeee;
        color: #e8591c;
        font-weight: 700;
        padding: 6px 14px;
        font-size: 18px;
        border-radius: 4px;
        display: inline-block;
    }

    /* Giá hiện tại */
    .price-current {
        font-size: 34px;
        font-weight: 700;
        color: #e8591c;
    }


    /* Giá cũ */
    .price-old {
        text-decoration: line-through;
        color: #9a9a9a;
        font-size: 20px;
        margin-left: 6px;
    }

    /* ===== Colors ===== */
    .color-options {
        margin-bottom: 25px;
    }

    .color-options .fw-bold {
        font-size: 16px;
        color: #222;
        margin-bottom: 10px;
    }

    .color-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 2px solid transparent;
        outline: 2px solid #ccc;
        cursor: pointer;
        margin-right: 12px;
        transition: all 0.25s ease;
        box-shadow: 0 0 0 1px #fff;
    }

    .color-btn:hover {
        transform: scale(1.15);
        outline-color: #999;
    }

    .color-btn.active {
        outline-color: var(--moho-primary);
        box-shadow: 0 0 0 3px rgba(0, 60, 88, 0.3);
        transform: scale(1.15);
    }

    /* ===== Quantity ===== */
    .quantity-box {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .quantity-control {
        display: flex;
        border: 1px solid #ccc;
        border-radius: 6px;
        overflow: hidden;
    }

    .quantity-btn {
        width: 45px;
        height: 45px;
        border: none;
        background: #f2f2f2;
        font-size: 20px;
        cursor: pointer;
        transition: 0.3s;
    }

    .quantity-btn:hover {
        background: var(--moho-brown);
        color: white;
    }

    .quantity-input {
        width: 60px;
        border: none;
        text-align: center;
        font-size: 16px;
    }

    .stock-info {
        font-size: 14px;
        color: #27ae60;
    }

    /* ===== Buttons ===== */
    .btn-row {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
    }

    .btn-add {
        flex: 1;
        background: var(--moho-primary);
        color: white;
        padding: 15px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-add:hover {
        background: #002b3e;
    }

    .btn-buy {
        flex: 1;
        background: var(--moho-accent);
        color: white;
        padding: 15px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-buy:hover {
        background: #cf4a17;
    }

    .btn-heart {
        width: 50px;
        height: 50px;
        border: 1px solid #ccc;
        background: white;
        border-radius: 50%;
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

    .btn-heart:hover {
        color: #e74c3c;
        border-color: #e74c3c;
    }

    /* ===== Guarantee Section ===== */
    .policy-list {
        list-style: none;
        padding-left: 0;
        font-size: 15px;
    }

    .policy-list li {
        margin-bottom: 10px;
    }

    .policy-list i {
        color: #27ae60;
        margin-right: 5px;
    }

    /* ===== Tabs ===== */
    .product-tabs {
        margin-top: 60px;
    }

    .nav-tabs {
        border-bottom: 2px solid #eee;
    }

    .nav-tabs .nav-link {
        font-weight: 600;
        color: #444;
        border: none;
        border-bottom: 3px solid transparent;
        transition: 0.3s;
    }

    .nav-tabs .nav-link:hover,
    .nav-tabs .nav-link.active {
        border-bottom-color: var(--moho-accent);
        color: var(--moho-accent);
    }

    .tab-content {
        background: #fff;
        padding: 30px;
        border: 1px solid #eee;
        border-top: none;
    }

    /* ===== Related Products ===== */
    .related-products {
        margin-top: 60px;
        padding-top: 60px;
        border-top: 2px solid #eee;
    }

    .section-title {
        font-size: 28px;
        text-align: center;
        margin-bottom: 40px;
        font-weight: 700;
    }

    .product-card {
        border: 1px solid #eee;
        border-radius: 6px;
        overflow: hidden;
        transition: 0.3s;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .product-card img {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }

    .product-card-body {
        padding: 15px;
    }

    .product-card-title {
        font-size: 16px;
        font-weight: 600;
        color: #333;
    }

    .product-card-price {
        color: #e74c3c;
        font-weight: 700;
        font-size: 18px;
    }

    /* ===== Services Section ===== */
    .services {
        background: var(--moho-bg);
        padding: 50px 0;
        margin-top: 60px;
    }

    .service-box {
        text-align: center;
        padding: 30px 10px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #eee;
    }

    .service-icon {
        font-size: 40px;
        color: var(--moho-primary);
        margin-bottom: 10px;
    }

    .service-title {
        font-weight: 700;
        font-size: 18px;
    }

    .service-sub {
        color: #666;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .product-detail {
            flex-direction: column;
        }

        .gallery-column {
            flex-direction: row;
            width: 100%;
        }

        .main-image img {
            height: auto;
        }
    }



    .product-rating i {
        font-size: 20px;
        margin-right: 2px;
    }

    .star-active {
        color: #ff9f00; /* vàng cam Moho */
    }

    .star-inactive {
        color: #ccc;
    }

    .rating-count {
        font-size: 15px;
        color: #666;
        margin-left: 4px;
        position: relative;
        top: 1px;
    }




    

</style>


<!-- Breadcrumb -->
<nav aria-label="breadcrumb">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/SanPham">Sản phẩm</a></li>
            <li class="breadcrumb-item"><a href="/SanPham/TheoDanhMuc/@Model.DanhMuc.IdDanhMuc">@Model.DanhMuc.TenDanhMuc</a></li>
            <li class="breadcrumb-item active">@Model.SanPham.TenSanPham</li>
        </ol>
    </div>
</nav>

<!-- Product Detail -->
<div class="container">
    <div class="product-detail">
        <!-- Gallery -->
        <div class="gallery-column">
            <img src="/Images/@Model.SanPham.HinhAnh" class="active" onclick="changeImage(this)">
            <img src="/Images/@Model.SanPham.HinhAnh" onclick="changeImage(this)">
            <img src="/Images/@Model.SanPham.HinhAnh" onclick="changeImage(this)">
        </div>

        <div class="main-image"><img src="/Images/@Model.SanPham.HinhAnh" id="mainImage"></div>

        <!-- Info -->
        <div class="product-info">
            <h1 class="product-title">@Model.SanPham.TenSanPham</h1>
            <div class="product-meta">SKU: @Model.SanPham.IdSanPham | Đã bán: @Model.SanPham.DaBan</div>

            <!-- Rating -->
            <div class="product-rating d-flex align-items-center mb-3">
                @{
                    int rating = Model.SanPham.DanhGia ?? 0;
                }

                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= rating)
                    {
                        <i class="bi bi-star-fill star-active"></i>
                    }
                    else
                    {
                        <i class="bi bi-star star-inactive"></i>
                    }
                }

                <span class="rating-count ms-2">(@rating)</span>
            </div>


            <!-- ==== PRICE BOX (Moho Style) ==== -->
            <div class="price-box text-start">
                @if (Model.SanPham.GiaKhuyenMai.HasValue && Model.SanPham.GiaKhuyenMai < Model.SanPham.Gia)
                {
                    @*<div class="price-inner d-flex align-items-center">
                <span class="discount-badge">-@(((Model.SanPham.Gia - Model.SanPham.GiaKhuyenMai.Value) / Model.SanPham.Gia * 100).ToString("0"))%</span>
                <span class="price-current">@Model.SanPham.GiaKhuyenMai.Value.ToString("N0") đ</span>
                <span class="price-old">@Model.SanPham.Gia.ToString("N0") đ</span>
            </div>*@

                    <div class="price-inner">
                        <span class="discount-tag">
                            -@(((Model.SanPham.Gia - Model.SanPham.GiaKhuyenMai.Value) / Model.SanPham.Gia * 100).ToString("0"))%
                        </span>

                        <span class="price-current">
                            @Model.SanPham.GiaKhuyenMai.Value.ToString("N0") đ
                        </span>

                        <span class="price-old">
                            @Model.SanPham.Gia.ToString("N0") đ
                        </span>
                    </div>

                }
                else
                {
                    <span class="price-current">@Model.SanPham.Gia.ToString("N0") đ</span>
                }
            </div>

            <!-- ==== COLOR OPTIONS ==== -->
            <div class="color-options mb-3">
                <div class="fw-bold mb-2">Màu tự nhiên</div>
                <div class="d-flex align-items-center">
                    <button class="color-btn active" style="background-color:#5a3e36;" title="Nâu đậm" onclick="selectColor(this)"></button>
                    <button class="color-btn" style="background-color:#c8ad7f;" title="Vàng nhạt" onclick="selectColor(this)"></button>
                </div>
            </div>


            <div class="quantity-box">
                <label class="fw-bold">Số lượng:</label>
                <div class="quantity-control">
                    <button class="quantity-btn" onclick="decreaseQuantity()">−</button>
                    <input type="number" id="quantity" class="quantity-input" value="1" min="1" max="@Model.SanPham.SoLuongTon">
                    <button class="quantity-btn" onclick="increaseQuantity()">+</button>
                </div>
                <span class="stock-info"><i class="bi bi-check-circle-fill"></i> Còn @Model.SanPham.SoLuongTon sản phẩm</span>
            </div>

            <div class="btn-row">
                <button class="btn-add"><i class="bi bi-cart-plus"></i> THÊM VÀO GIỎ</button>
                <button class="btn-buy">MUA NGAY</button>
                <button class="btn-heart"><i class="bi bi-heart"></i></button>
            </div>

            <ul class="policy-list">
                <li><i class="bi bi-check-circle-fill"></i> Miễn phí giao hàng & lắp đặt tại TP.HCM, Hà Nội, Biên Hòa, Bình Dương...</li>
                <li><i class="bi bi-check-circle-fill"></i> Miễn phí 1 đổi 1 – Bảo hành 5 năm – Bảo trì trọn đời</li>
                <li><i class="bi bi-check-circle-fill"></i> (*) Không áp dụng cho danh mục Đồ Trang Trí</li>
            </ul>
        </div>
    </div>

    <!-- Tabs -->
    <div class="product-tabs">
        <ul class="nav nav-tabs">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#moTa">Mô tả</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#danhGia">Đánh giá</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#chinhSach">Chính sách</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#baoQuan">Bảo quản</a></li>
        </ul>

        <div class="tab-content">
            <div id="moTa" class="tab-pane fade show active">@Html.Raw(Model.SanPham.MoTaChiTiet)</div>
            <div id="danhGia" class="tab-pane fade"><p>Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá sản phẩm này!</p></div>
            <div id="chinhSach" class="tab-pane fade"><p>• Miễn phí giao hàng & lắp đặt tại TP.HCM, Hà Nội, Biên Hòa, Bình Dương.<br>• Đổi trả 1-1 trong 7 ngày.<br>• Bảo hành 5 năm – Bảo trì trọn đời.</p></div>
            <div id="baoQuan" class="tab-pane fade"><p>• Tránh để sản phẩm tiếp xúc trực tiếp ánh nắng, nước.<br>• Lau chùi bằng khăn mềm, tránh chất tẩy mạnh.</p></div>
        </div>
    </div>

    <!-- Related Products -->
    <div class="related-products">
        <h2 class="section-title">SẢN PHẨM LIÊN QUAN</h2>
        <div class="row g-4">
            @foreach (var sp in Model.SanPhamLienQuan)
            {
                <div class="col-md-3">
                    <div class="product-card">
                        <img src="/Images/@sp.HinhAnh" />
                        <div class="product-card-body">
                            <h5 class="product-card-title">@sp.TenSanPham</h5>
                            <div class="product-card-price">@sp.Gia.ToString("N0") đ</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Service Commitments -->
    <div class="services">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-md-3"><div class="service-box"><div class="service-icon"><i class="bi bi-truck"></i></div><div class="service-title">Giao Hàng & Lắp Đặt</div><div class="service-sub">Miễn Phí</div></div></div>
                <div class="col-md-3"><div class="service-box"><div class="service-icon"><i class="bi bi-arrow-repeat"></i></div><div class="service-title">Đổi Trả 1 - 1</div><div class="service-sub">Miễn Phí</div></div></div>
                <div class="col-md-3"><div class="service-box"><div class="service-icon"><i class="bi bi-shield-check"></i></div><div class="service-title">Bảo Hành Đến 5 Năm</div><div class="service-sub">Miễn Phí</div></div></div>
                <div class="col-md-3"><div class="service-box"><div class="service-icon"><i class="bi bi-telephone"></i></div><div class="service-title">Tư Vấn Thiết Kế</div><div class="service-sub">Miễn Phí</div></div></div>
            </div>
        </div>
    </div>
</div>

<script>
    function changeImage(el) {
        document.getElementById("mainImage").src = el.src;
        document.querySelectorAll(".gallery-column img").forEach(i => i.classList.remove("active"));
        el.classList.add("active");
    }
    function increaseQuantity() { let q = document.getElementById('quantity'); if (parseInt(q.value) < parseInt(q.max)) q.value++; }
    function decreaseQuantity() { let q = document.getElementById('quantity'); if (parseInt(q.value) > 1) q.value--; }
    // cho pheps chon mau
    function selectColor(el) {
        document.querySelectorAll(".color-btn").forEach(btn => btn.classList.remove("active"));
        el.classList.add("active");
    }
</script>
