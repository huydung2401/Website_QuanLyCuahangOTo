@model TKW.Models.ChiTietSanPham

<style>
    .size-btn {
        padding: 8px 15px;
        border: 1px solid #666;
        border-radius: 6px;
        background: white;
        cursor: pointer;
        transition: 0.2s;
    }

        .size-btn:hover {
            border-color: #ff6a00;
            color: #ff6a00;
        }

        .size-btn.active {
            background: #ff6a00 !important;
            color: white !important;
            border-color: #ff6a00 !important;
        }
</style>

@if (Model.BienThes != null && Model.BienThes.Any())
{
    var firstItem = Model.BienThes.First();

    <div class="variant-block">

        <!-- GIÁ HIỆN TẠI -->
        <div class="d-flex align-items-center gap-3 mb-3">

            @if (firstItem.GiaCu.HasValue && firstItem.GiaCu > firstItem.Gia)
            {
                <span id="discount-box"
                      class="discount-tag bg-danger text-white px-2 rounded"
                      style="font-size:14px;">
                    -@firstItem.GiamGia%
                </span>
            }

            <span id="gia-ban" class="price-current fw-bold text-danger" style="font-size:24px;">
                @(firstItem.Gia?.ToString("N0") ?? "0") đ
            </span>

            @if (firstItem.GiaCu.HasValue && firstItem.GiaCu > 0)
            {
                <del id="gia-cu" class="price-old text-muted ms-2">
                    @firstItem.GiaCu.Value.ToString("N0") đ
                </del>
            }
        </div>

        <!-- NÚT CHỌN BIẾN THỂ -->
        <div class="size-options mb-4">
            <div class="fw-bold mb-2">Kích thước / Loại:</div>

            <div class="d-flex flex-wrap gap-2">
                @foreach (var item in Model.BienThes)
                {
                    <button class="size-btn @(item == firstItem ? "active" : "")"
                            data-gia="@item.Gia"
                            data-giacu="@item.GiaCu"
                            data-giamgia="@item.GiamGia">
                        @item.TenBienThe
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- SCRIPT CẬP NHẬT GIÁ -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btns = document.querySelectorAll(".size-btn");

            btns.forEach(btn => {
                btn.addEventListener("click", function () {

                    btns.forEach(x => x.classList.remove("active"));
                    this.classList.add("active");

                    let gia = Number(this.dataset.gia);
                    let giacu = Number(this.dataset.giacu);
                    let giamgia = Number(this.dataset.giamgia);

                    const giaBan = document.getElementById("gia-ban");
                    const giaCu = document.getElementById("gia-cu");
                    const discountBox = document.getElementById("discount-box");

                    if (giaBan) {
                        giaBan.innerText = gia.toLocaleString("vi-VN") + " đ";
                    }

                    if (giaCu) {
                        if (giacu > 0 && giacu > gia) {
                            giaCu.innerText = giacu.toLocaleString("vi-VN") + " đ";
                            giaCu.style.display = "inline";
                        } else {
                            giaCu.style.display = "none";
                        }
                    }

                    if (discountBox) {
                        if (giamgia > 0) {
                            discountBox.innerText = `-${giamgia}%`;
                            discountBox.style.display = "inline-block";
                        } else {
                            discountBox.style.display = "none";
                        }
                    }
                });
            });
        });
    </script>
}
else
{
    <!-- SẢN PHẨM KHÔNG CÓ BIẾN THỂ -->
    <div class="price-box text-start">
        @if (Model.SanPham.GiaKhuyenMai.HasValue &&
             Model.SanPham.GiaKhuyenMai < Model.SanPham.Gia)
        {
            <div class="price-inner">
                <span class="discount-tag bg-danger text-white px-2 rounded">
                    -@(((Model.SanPham.Gia - Model.SanPham.GiaKhuyenMai.Value)
                        / Model.SanPham.Gia * 100).ToString("0"))%
                </span>

                <span class="price-current fw-bold text-danger ms-2" style="font-size:24px;">
                    @Model.SanPham.GiaKhuyenMai.Value.ToString("N0") đ
                </span>

                <span class="price-old text-muted ms-2" style="text-decoration:line-through">
                    @Model.SanPham.Gia.ToString("N0") đ
                </span>
            </div>
        }
        else
        {
            <span class="price-current fw-bold text-danger" style="font-size:24px;">
                @Model.SanPham.Gia.ToString("N0") đ
            </span>
        }
    </div>
}
