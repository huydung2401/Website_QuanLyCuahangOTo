@model TKW.Models.ChiTietSanPham

<style>
    .size-btn {
        padding: 8px 15px;
        border: 1px solid #666;
        border-radius: 6px;
        background: white;
        cursor: pointer;
        transition: 0.2s;
    }

        .size-btn:hover {
            border-color: #ff6a00;
            color: #ff6a00;
        }

        .size-btn.active {
            background: #ff6a00 !important;
            color: white !important;
            border-color: #ff6a00 !important;
        }
</style>

<div class="variant-block">
    @{
        bool hasBienThe = Model.BienThes != null && Model.BienThes.Any();
        var first = hasBienThe ? Model.BienThes.First() : null;
    }

    <!-- GIÁ BAN ĐẦU -->
    @if (hasBienThe)
    {
        <div class="d-flex align-items-center gap-3 mb-3">
            <span id="discount-box" class="discount-box">
                -@first.GiamGia%
            </span>

            <span id="gia-ban" class="gia-ban">
                @first.Gia.Value.ToString("N0") đ
            </span>

            <del id="gia-cu" class="gia-cu">
                @first.GiaCu.Value.ToString("N0") đ
            </del>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="gia-ban" style="font-size: 32px; color:#e85c1c; font-weight:700;">
                @Model.SanPham.Gia.ToString("N0") đ
            </span>
        </div>
    }

    <!-- BIẾN THỂ GIƯỜNG -->
    <div class="size-options mb-4">
        <div class="fw-bold mb-2">Kích thước</div>

        <div class="d-flex flex-wrap gap-2">
            @foreach (var item in Model.BienThes)
            {
                <button class="size-btn"
                        data-gia="@item.Gia"
                        data-giacu="@item.GiaCu"
                        data-giamgia="@item.GiamGia">
                    @item.TenBienThe
                </button>
            }
        </div>
    </div>
</div>

<script>
    document.querySelectorAll(".size-btn").forEach(btn => {
        btn.addEventListener("click", function () {

            document.querySelectorAll(".size-btn")
                .forEach(x => x.classList.remove("active"));

            this.classList.add("active");

            let gia = this.dataset.gia;
            let giacu = this.dataset.giacu;
            let giamgia = this.dataset.giamgia;

            document.getElementById("gia-ban").innerText =
                Number(gia).toLocaleString("vi-VN") + " đ";

            document.getElementById("gia-cu").innerText =
                Number(giacu).toLocaleString("vi-VN") + " đ";

            document.getElementById("discount-box").innerText =
                `-${giamgia}%`;
        });
    });
</script>

