<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Moho Furniture Store</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/site.css" />
    <link rel="stylesheet" href="~/Content/css/cart.css" />
    <link rel="stylesheet" href="~/Content/css/_Layout.css" />

    <!-- Icons & Fonts -->
 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">


    @RenderSection("Styles", required: false)
</head>

<body>
    <header class="shadow-sm">
        <div class="top-bar py-2">
            <div class="container d-flex justify-content-between align-items-center">

                <!-- Logo -->
                <a href="@Url.Action("Index","Home")" class="d-flex align-items-center">
                    <img src="~/Content/images/logo-carmudi.png" class="carmudi-logo">
                </a>

                <!-- MENU CHÍNH -->
                <nav class="main-menu d-none d-md-flex">
                    <a href="#" class="menu-item">Mua xe <i class="fas fa-chevron-down ml-1"></i></a>
                    <a href="#" class="menu-item">Bán xe</a>
                    <a href="@Url.Action("GioiThieu","Home")" class="menu-item">Giới thiệu</a>
                    <a href="#" class="menu-item">Tin tức</a>
                    <a href="#" class="menu-item">Tài chính Toyota</a>
                </nav>

                <!-- ACTION ZONE -->
                <div class="actions d-flex align-items-center">

                    <!-- ĐĂNG TIN -->
                    <a href="#" class="btn-post mr-5">
                        <i class="fas fa-car-side mr-4"></i> ĐĂNG TIN
                    </a>

                    <!-- PHONE -->
                    <!--<div class="phone-box mr-4">
                        <i class="fas fa-phone-alt"></i> 0967 390 575
                    </div>-->
                    <!-- Nhóm người dùng + Giỏ hàng -->
                    <div class="d-flex align-items-center">

                        @if (Session["User"] == null)
                        {
                            <!-- CHƯA ĐĂNG NHẬP -->
                            <div class="nav-item dropdown d-flex align-items-center user-box mr-4" style="white-space:nowrap;">

                                <i class="far fa-user user-icon mr-2"></i>

                                <a href="#" class="nav-link p-0 open-login-modal">
                                    Đăng nhập/Đăng ký
                                </a>

                            </div>
                        }
                        else
                        {
                            <!-- ĐÃ ĐĂNG NHẬP -->
                            var userName = Session["UserName"] as string;

                            <div class="nav-item dropdown d-flex align-items-center mr-3" style="white-space:nowrap;">

                                <i class="fas fa-user fa-lg mr-2"></i>

                                <a href="#" class="nav-link p-0 dropdown-toggle"
                                   id="accountDropdown"
                                   data-toggle="dropdown" aria-expanded="false">
                                    Xin chào, @userName
                                </a>

                                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="accountDropdown">
                                    <a class="dropdown-item" href="/TaiKhoan/ThongTin">Thông tin cá nhân</a>
                                    <a class="dropdown-item" href="/DonHang/CuaToi">Đơn hàng của tôi</a>
                                    <a class="dropdown-item" href="/TaiKhoan/DangXuat">Đăng xuất</a>
                                </div>

                            </div>
                        }

                        <!-- Giỏ hàng -->
                        <a href="#" id="btnCart" class="nav-link d-flex align-items-center position-relative" style="white-space:nowrap;">
                            <i class="fas fa-shopping-cart fa-lg mr-1"></i>
                            <span>Giỏ hàng</span>

                            <span id="cartBadge"
                                  class="badge badge-danger position-absolute"
                                  style="top:-5px; right:-10px; font-size:0.75rem;">
                                0
                            </span>
                        </a>

                    </div>



                </div>

            </div>
        </div>

        <!-- Thanh banner dưới header -->
        <!-- Thanh search -->
    </header>

    <!-- ==================== LOGIN POPUP ==================== -->
    <div id="loginPopup" class="login-popup">
        <div class="login-box">
            <h2 class="login-title">ĐĂNG NHẬP TÀI KHOẢN</h2>
            <p class="login-sub">Nhập email và mật khẩu của bạn:</p>

            <form action="/TaiKhoan/DangNhap" method="post">
                <input type="text" name="Email" class="input-box" placeholder="Email hoặc SĐT" required>
                <input type="password" name="MatKhau" class="input-box" placeholder="Mật khẩu" required>
                <button class="btn-login">ĐĂNG NHẬP</button>
            </form>

            <div class="login-footer">
                <p>Khách hàng mới? <a href="/TaiKhoan/DangKy">Tạo tài khoản</a></p>
                <p>Quên mật khẩu? <a href="#">Khôi phục mật khẩu</a></p>
            </div>
        </div>
    </div>

    <!-- ==================== BODY ==================== -->
    <main class="container-fluid px-0 mt-3">
        @RenderBody()
    </main>

    <!-- ==================== FOOTER ==================== -->
    <footer style="background-color: #1d1d1d; color: #eee; padding: 10px 50px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
        <div style="max-width: 1100px; margin: auto; display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between;">

            <!-- Cột 1: Hỗ trợ và liên hệ -->
            <div style="flex: 1 1 250px; min-width: 250px;">
                <h5 style="font-size: 1.3rem; margin-bottom: 20px; color: #3dd1c3; text-transform: uppercase; letter-spacing: 1.2px;">Hỗ trợ và liên hệ</h5>
                <p style="margin: 6px 0;"><strong>Hotline:</strong> <a href="tel:0967390575" style="color:#a0f0e6; text-decoration:none;">0967 390 575</a></p>
                <p style="margin: 6px 0;"><strong>Email:</strong> <a href="mailto:salehdn@HomeDecor.vn" style="color:#a0f0e6; text-decoration:none;">salehdn@HomeDecor.vn</a></p>
                <img src="~/Content/images/logo-carmudi.png" alt="MoHo" style="width: 80px;">
            </div>

            <!-- Cột 2: Giới thiệu -->
            <div style="flex: 1 1 180px; min-width: 180px;">
                <h5 style="font-size: 1.3rem; margin-bottom: 20px; color: #3dd1c3; text-transform: uppercase; letter-spacing: 1.2px;">Giới thiệu</h5>
                <ul style="list-style: none; padding-left: 0; margin: 0; color: #ccc; font-size: 0.95rem;">
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Về cửa hàng Carmudi</li>
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Tuyển dụng</li>
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Hệ thống cửa hàng</li>
                </ul>
            </div>

            <!-- Cột 3: Hướng dẫn -->
            <div style="flex: 1 1 180px; min-width: 180px;">
                <h5 style="font-size: 1.3rem; margin-bottom: 20px; color: #3dd1c3; text-transform: uppercase; letter-spacing: 1.2px;">Hướng dẫn</h5>
                <ul style="list-style: none; padding-left: 0; margin: 0; color: #ccc; font-size: 0.95rem;">
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Đặt hàng</li>
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Giao hàng &amp; Lắp đặt</li>
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Sử dụng sản phẩm</li>
                    <li style="margin-bottom: 12px; cursor: pointer; transition: color 0.3s;">Bảo hành &amp; Bảo trì</li>
                </ul>
            </div>

            <!-- Cột 4: Kết nối & email -->
            <div style="flex: 1 1 220px; min-width: 220px;">
                <h5 style="font-size: 1.3rem; margin-bottom: 20px; color: #3dd1c3; text-transform: uppercase; letter-spacing: 1.2px;">Kết nối với Carmudi</h5>
                <form style="display: flex; gap: 6px; margin-bottom: 20px;">
                    <input type="email" placeholder="Nhập địa chỉ email"
                           style="flex: 1; padding: 4px 8px; font-size: 0.8rem; border-radius: 4px; border: 1px solid #ccc; height: 30px;" required />
                    <button type="submit"
                            style="padding: 4px 12px; font-size: 0.8rem; border-radius: 4px; background: #3dd1c3; border: none; color: #1d1d1d; font-weight: 600; cursor: pointer; height: 30px; transition: background-color 0.3s;">
                        Sign up
                    </button>
                </form>


                <div style="display: flex; gap: 15px;">
                    <!-- Facebook -->
                    <a href="https://www.facebook.com/share/19xpFfpeix/" target="_blank" style="display: inline-block; transition: transform 0.3s;">
                        <img src="https://img.icons8.com/color/32/facebook.png" alt="Facebook" />
                    </a>
                    <!-- Instagram -->
                    <a href="https://instagram.com/pham_dung2401" target="_blank" style="display: inline-block; transition: transform 0.3s;">
                        <img src="https://img.icons8.com/color/32/instagram-new.png" alt="Instagram" />
                    </a>

                    <!-- Shopee -->
                    <a href="https://shopee.vn/shop-cua-ban" target="_blank" style="display: inline-block; transition: transform 0.3s;">
                        <img src="https://img.icons8.com/color/32/shopify.png" alt="Shopee" />
                    </a>
                </div>
            </div>
        </div>
        <hr style="border-color: #444; margin: 10px 0; opacity: 0.5;">

        <p style="text-align: center; color: #bbb; font-size: 0.8rem; user-select: none;">
            © 2025 Bản quyền thuộc về Carmudi - Cửa hàng trao đổi mua bán uy tín
        </p>

    </footer>

    @RenderSection("Scripts", required: false)

    <!-- Cart scripts -->
    @*<script src="~/Scripts/cart.js"></script>
        <script src="~/Scripts/_Layout.js"></script>*@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>
    <script src="~/Scripts/cart.js"></script>
    <script src="~/Scripts/_Layout.js"></script>
</body>
</html>

<style>

    /* ===============================
   HEADER GIỐNG CARMUDI
================================*/
    header {
        background: #fff;
        border-bottom: 1px solid #eeeeee;
        padding: 5px 0;
    }

    /* Thanh trên của header */
    .top-bar {
        background: #fff;
        /* tăng chiều cao giống carmudi */
        padding-top: 8px;
        padding-bottom: 8px;
    }

        /* Cho header “dài” hơn – giống chiều rộng carmudi */
        .top-bar .container {
            max-width: 1360px; /* rộng hơn container mặc định */
            width: 100%;
        }

    /* Logo bên trái */
    .carmudi-logo {
        height: 30px;
    }
    /* MENU CHÍNH Ở GIỮA – CĂN GIỐNG CARMUDI */
    /* Cấu hình font chung */
    body {
        font-family: 'Inter', sans-serif;
    }

    /* Menu chính */
    .main-menu {
        display: flex;
        align-items: center;
        white-space: nowrap; /* Không cho xuống dòng */
        margin-left: 40px;
        gap: 32px; /* Khoảng cách đều nhau */
    }

        /* Kiểu chữ giống Carmudi */
        .main-menu .menu-item {
            font-family: 'Inter', sans-serif;
            font-size: 16px;
            font-weight: 500;
            color: #2c2c2c !important;
            padding: 0; /* bỏ padding làm tràn hàng */
            line-height: normal !important; /* NGĂN CHỮ XUỐNG DÒNG */
            letter-spacing: 0.2px;
            transition: color 0.2s;
            display: flex;
            align-items: center; /* center icon + text */
        }

            /* Hover */
            .main-menu .menu-item:hover {
                color: #0066cc !important;
                text-decoration: none;
            }

            /* Active */
            .main-menu .menu-item.active {
                font-weight: 600;
                color: #0066cc !important;
            }

            /* Icon ▼ */
            .main-menu .menu-item i {
                margin-left: 4px;
            }



    /* KHỐI BÊN PHẢI (ĐĂNG TIN + PHONE + USER) */
    .actions {
        display: flex;
        align-items: center;
        gap: 24px; /* giống khoảng cách bên trái */
    }

    /* Nút ĐĂNG TIN */
    .btn-post {
        background: #ef7f31;
        color: #fff !important;
        padding: 8px 18px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        margin-left: 10px !important; /* giảm kéo nút xa menu */
        margin-right: 28px !important; /* đưa nút gần qua phải */
    }



        .btn-post:hover {
            background: #d96f20;
            color: #fff !important;
        }

    /* Phone */
    .phone-box {
        font-size: 14px;
        font-weight: 500;
        color: #222;
        white-space: nowrap;
    }

        .phone-box i {
            margin-right: 6px;
            color: #333;
        }

    /* User */
    .user-area .user-text {
        font-size: 14px;
        color: #222;
        white-space: nowrap;
    }

        .user-area .user-text:hover {
            color: #007bff;
        }

    .user-area .dropdown-menu {
        min-width: 160px;
    }


    .dropdown-menu {
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    /* ================================
        SEARCH BOX (giống Carmudi)
    ================================ */
    .search-section {
        background: #fff;
        border-bottom: 1px solid #eee;
    }
    .search-wrapper {
        background: #f5f8fb;
        border: 1px solid #dfe4ea;
        border-radius: 10px;
        padding: 12px 18px;
        display: flex;
        align-items: center;
    }
    .search-icon {
        color: #8899a6;
        font-size: 18px;
        margin-right: 12px;
    }
    .search-input {
        width: 100%;
        border: none;
        font-size: 15px;
        background: transparent;
        outline: none;
    }

    /* ================================
        LOGIN POPUP
    ================================ */
    .login-popup {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.45);
        display: none;
        justify-content: flex-end;
        align-items: flex-start;
        padding-right: 120px;
        padding-top: 85px;
        z-index: 9999;
    }
    .login-popup.active {
        display: flex !important;
    }

    .login-box {
        width: 380px;
        background: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.25);
    }

    .login-box input {
        height: 42px;
        font-size: 15px;
    }

    .btn-login {
        background: #ef7f31;
        color: #fff;
        padding: 10px 0;
        width: 100%;
        border-radius: 6px;
    }
    .btn-login:hover {
        background: #d96f20;
    }

    /* ===== FOOTER ===== */
    footer {
        background-color: #343a40;
        color: #fff;
        padding: 30px 0;
    }

        footer a, footer ul li {
            transition: color 0.3s ease;
            cursor: pointer;
        }

            footer a:hover, footer ul li:hover {
                color: #3dd1c3;
                transform: translateY(-2px);
                text-shadow: 0 2px 5px rgba(0,0,0,0.4);
            }

    /* ================================
        RESPONSIVE TUNING
    ================================ */
    @@media (max-width: 768px) {
        .main-menu { display: none !important; }
        .btn-post { padding: 6px 14px; font-size: 13px; }
        .search-wrapper { padding: 10px; }
    }

</style>
