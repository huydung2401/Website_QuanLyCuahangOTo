@model TKW.Models.MenuView

@* View cho phần mua xe *@
<div class="dropdown-menu mega-menu p-4 shadow mt-0" aria-labelledby="navbarDropdown">
    <div class="row">
        <div class="col-md-4">
            <h6 class="menu-title">HÃNG XE PHỔ BIẾN</h6>
            <ul class="list-unstyled">
                @if (Model.HangXePhoBien != null)
                {
                    foreach (var hang in Model.HangXePhoBien)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Home", new { hangXe = hang.IdHangXe })" class="menu-link">
                                @hang.TenHang
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>

        <div class="col-md-4">
            <h6 class="menu-title">DÒNG XE PHỔ BIẾN</h6>
            <ul class="list-unstyled">
                @if (Model.DongXePhoBien != null)
                {
                    foreach (var dong in Model.DongXePhoBien)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Home", new { tuKhoa = dong.TenDong })" class="menu-link">
                                @dong.TenDong
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>

        <div class="col-md-4">
            <h6 class="menu-title">GIÁ XE</h6>
            <ul class="list-unstyled">
                <li><a href="@Url.Action("Index", "Home", new { mucGia = "0-300" })" class="menu-link">Dưới 300 triệu</a></li>
                <li><a href="@Url.Action("Index", "Home", new { mucGia = "300-500" })" class="menu-link">Từ 300 - 500 triệu</a></li>
                <li><a href="@Url.Action("Index", "Home", new { mucGia = "500-700" })" class="menu-link">Từ 500 - 700 triệu</a></li>
                <li><a href="@Url.Action("Index", "Home", new { mucGia = "700-1000" })" class="menu-link">Từ 700 - 1 tỷ</a></li>
                <li><a href="@Url.Action("Index", "Home", new { mucGia = "1000-max" })" class="menu-link">Trên 1 tỷ</a></li>
            </ul>

        </div>
    </div>
</div>

<style>
    /* CSS cho Mega Menu */
    .mega-menu {
        width: 600px;
        border-radius: 8px;
        border: 1px solid #eee;
        /* Loại bỏ margin-top lớn để menu sát vào nút bấm */
        margin-top: 0px;
    }

    .menu-title {
        font-weight: 700;
        color: #333;
        margin-bottom: 15px;
        text-transform: uppercase;
        font-size: 14px;
        letter-spacing: 0.5px;
    }

    .menu-link {
        color: #555;
        font-size: 14px;
        display: block;
        padding: 6px 0;
        text-decoration: none;
        transition: 0.2s;
    }

        .menu-link:hover {
            color: #007bff;
            text-decoration: none;
            transform: translateX(5px);
        }
</style>