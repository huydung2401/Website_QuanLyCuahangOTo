@{
    ViewBag.Title = "Tạo tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .register-wrap {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 0;
        gap: 80px;
    }

    .register-left {
        flex: 1;
    }

    .reg-title {
        font-size: 48px;
        font-weight: 700;
    }

    .reg-desc {
        margin-top: 10px;
        font-size: 18px;
        color: #666;
        max-width: 400px;
    }

    .reg-line {
        width: 55px;
        height: 4px;
        background: #000;
        margin-top: 18px;
    }

    .register-right {
        flex: 1;
    }

    .input-box {
        width: 100%;
        padding: 15px;
        border-radius: 6px;
        border: 1px solid #ddd;
        background: #efefef;
        margin-bottom: 16px;
        font-size: 16px;
    }

    .btn-register {
        background: #2d2d2d;
        color: #fff;
        width: 100%;
        padding: 14px 0;
        border-radius: 6px;
        margin-top: 10px;
        border: none;
        font-size: 17px;
    }

        .btn-register:hover {
            background: #000;
        }

    .back-home {
        display: inline-block;
        margin: 20px 0;
        font-size: 16px;
        color: #2d2d2d;
    }

    .social-login {
        display: flex;
        gap: 10px;
    }

    .btn-google {
        background: #db4437;
        color: #fff;
        padding: 10px 18px;
        border-radius: 6px;
        border: none;
    }

    .btn-facebook {
        background: #4267B2;
        color: #fff;
        padding: 10px 18px;
        border-radius: 6px;
        border: none;
    }

    .captcha-note {
        font-size: 14px;
        color: #777;
        margin-bottom: 15px;
    }

    @@media (max-width: 992px) {
        .register-wrap {
            flex-direction: column;
            gap: 40px;
            padding: 40px 20px;
        }
    }
</style>

<div class="container">
    <div class="register-wrap">

        <!-- CỘT TRÁI -->
        <div class="register-left">
            <h1 class="reg-title">Tạo tài khoản</h1>
            <p class="reg-desc">
                Đăng ký tài khoản chỉ trong 1 phút để tích lũy điểm và nhận ưu đãi.
            </p>
            <div class="reg-line"></div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="register-right">
            <form id="formDangKy" action="/TaiKhoan/DangKy" method="post">
                @Html.AntiForgeryToken()

                <!-- Họ / Tên -->
                <input type="text" id="Ho" class="input-box" placeholder="Họ" required />
                <input type="text" id="Ten" class="input-box" placeholder="Tên" required />

                <!-- Hidden gửi lên đúng field HoTen trong model -->
                <input type="hidden" name="HoTen" id="HoTen" />
                <!-- Email (BẮT BUỘC – khớp với DB) -->
                <input type="email" name="Email" class="input-box" placeholder="Email" required />

                <!-- Số điện thoại (tùy chọn) -->
                <input type="text" name="DienThoai" class="input-box" placeholder="Số điện thoại" />

                <!-- Mật khẩu -->
                <input type="password" name="MatKhau" class="input-box" placeholder="Mật khẩu" required />

                <p class="captcha-note">
                    Website được bảo vệ bởi reCAPTCHA và
                    <a href="#">Chính sách bảo mật</a> và
                    <a href="#">Điều khoản dịch vụ</a> của Google.
                </p>

                <button type="submit" class="btn-register">ĐĂNG KÝ</button>

                <a href="/" class="back-home">← Quay lại trang chủ</a>

                <div class="social-login">
                    <button type="button" class="btn-google">Đăng nhập Google</button>
                    <button type="button" class="btn-facebook">Đăng nhập Facebook</button>
                </div>

                @if (TempData["Error"] != null)
                {
                    <p style="color:red; margin-top:10px;">@TempData["Error"]</p>
                }
                @if (TempData["Success"] != null)
                {
                    <p style="color:green; margin-top:10px;">@TempData["Success"]</p>
                }
            </form>
        </div>

    </div>
</div>

<script>
    // Gộp Họ + Tên vào HoTen trước khi submit
    document.getElementById("formDangKy").addEventListener("submit", function () {
        var ho = document.getElementById("Ho").value.trim();
        var ten = document.getElementById("Ten").value.trim();
        document.getElementById("HoTen").value = (ho + " " + ten).trim();
    });
</script>