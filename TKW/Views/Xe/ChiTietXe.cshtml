@model TKW.Models.XeDetailViewModel

@{
    ViewBag.Title = "ChiTietXe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/carmudi-detail.css" />
<link rel="stylesheet" href="~/Content/css/ChiTietXe.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<div class="carmudi-container">
    <nav class="breadcrumb-custom">
        <a href="/">Trang chủ</a> ›
        <a href="/Xe/Hang/@Model.HangXe.IdHangXe">@Model.HangXe.TenHang</a> ›
        <a href="/Xe/Dong/@Model.DongXe.IdDongXe">@Model.DongXe.TenDong</a> ›
        <a href="/Xe/DanhMuc/@Model.DanhMuc.IdDanhMuc">@Model.DanhMuc.TenDanhMuc</a> ›
        <span>@Model.Xe.TieuDe</span>
    </nav>
</div>


<div class="carmudi-container detail-container">

    <div class="row">
        <!-- ẢNH LỚN -->
        <div class="col-lg-7 col-md-12 ">
            <div class="left-sticky">
                @{
                    string mainImg = Model.HinhAnh.FirstOrDefault()?.HinhAnh ?? "noimage.jpg";
                }

                <!-- MAIN IMAGE -->
                <div class="main-image-box">
                    <img id="mainImage"
                         src="@Url.Content("~/Content/Images/" + mainImg)"
                         onerror="this.src='/Content/Images/noimage.jpg'; this.onerror=null;">
                </div>


                <!-- THUMBNAIL LIST -->
                <div class="thumb-list">

                    <!-- ẢNH CHÍNH (DB) -->
                    @foreach (var img in Model.HinhAnh)
                    {
                        <img src="@Url.Content("~/Content/Images/" + img.HinhAnh)"
                             class="thumb-item"
                             onclick="changeImage(this)"
                             onerror="this.style.display='none'" />
                    }

                    <!-- 5 ẢNH AUTO: tên ảnh sẽ theo dạng 001_1.jpg, 002_1.jpg... -->
                    @if (Model.HinhAnh.Any())
                    {
                        string baseName = System.IO.Path.GetFileNameWithoutExtension(mainImg);
                        string ext = System.IO.Path.GetExtension(mainImg);

                        for (int i = 1; i <= 5; i++)
                        {
                            string autoImg = baseName + "_" + i + ext;

                            <img src="@Url.Content("~/Content/Images/" + autoImg)"
                                 class="thumb-item"
                                 onclick="changeImage(this)"
                                 onerror="this.style.display='none'" />
                        }
                    }

                </div>
                <div class="benefit-box d-flex justify-content-between align-items-center mt-3">

                    <div class="benefit-item">
                        <div class="icon-wrap">
                            <i class="fa-solid fa-car"></i>
                        </div>
                        <span>Đạt kiểm định chính hãng</span>
                    </div>

                    <div class="benefit-item">
                        <div class="icon-wrap">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <span>Pháp lý an toàn</span>
                    </div>

                    <div class="benefit-item">
                        <div class="icon-wrap">
                            <i class="fa-solid fa-ban"></i>
                        </div>
                        <span>Không đâm đụng</span>
                    </div>

                </div>
            </div>
            </div>
            <!-- INFO BOX -->
        


            <div class="info-section info-sticky">

                <h1 class="car-title">@Model.Xe.TieuDe</h1>

                <div class="car-price">
                    @Model.Xe.Gia.ToString("N0") đ
                </div>

                <div class="info-row">
                    <div class="info-item">
                        <i class="fas fa-gas-pump"></i>
                        <span>Nhiên liệu</span>
                    </div>
                    <div class="info-value">@Model.Xe.NhienLieu</div>
                </div>

                <div class="info-row">
                    <div class="info-item">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Số KM</span>
                    </div>
                    <div class="info-value">
                        @(Model.Xe.SoKM.HasValue
                        ? Model.Xe.SoKM.Value.ToString("N0") + " km"
                        : "Không rõ")
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-item">
                        <i class="fas fa-cogs"></i>
                        <span>Hộp số</span>
                    </div>
                    <div class="info-value">@Model.Xe.HopSo</div>
                </div>

                <div class="info-row">
                    <div class="info-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Địa điểm</span>
                    </div>
                    <div class="info-value">@Model.Xe.DiaDiem</div>
                </div>

                <div class="info-row">
                    <div class="info-item">
                        <i class="fas fa-user"></i>
                        <span>Đăng bởi</span>
                    </div>
                    <div class="info-value">@Model.NguoiBan.HoTen</div>
                </div>

                <div class="btn-group-contact">
                    <a href="#" class="contact-btn btn-call">
                        <i class="fas fa-phone-alt"></i>
                        <span>Gọi điện/Nhắn tin</span>
                    </a>

                    <a href="@Url.Action("TaoYeuCau", "DatCoc", new { idXe = Model.Xe.IdXe })"
                        class="contact-btn btn-deposit">
                        <i class="fas fa-file-contract"></i>
                        <span>Đặt giữ xe ngay</span>
                    </a>


                    <button type="button"
                            class="contact-btn btn-test-drive"
                            data-toggle="modal"
                            data-target="#modalLaiThu">
                        <i class="fas fa-steering-wheel"></i>
                        <span>Đăng ký lái thử</span>
                    </button>


             
                </div>


            </div>

        
            <!-- SPEC -->
            <section class="spec-box">
                <h2>Thông số kỹ thuật</h2>
                <table class="spec-table">
                    <tr><th>Hãng xe</th><td>@Model.HangXe.TenHang</td></tr>
                    <tr><th>Dòng xe</th><td>@Model.DongXe.TenDong</td></tr>
                    <tr><th>Loại xe</th><td>@Model.DanhMuc.TenDanhMuc</td></tr>
                    <tr><th>Năm sản xuất</th><td>@Model.Xe.NamSX</td></tr>
                    <tr><th>Động cơ</th><td>@Model.Xe.DongCo</td></tr>
                    <tr><th>Công suất</th><td>@Model.Xe.CongSuat</td></tr>
                    <tr><th>Kích thước</th><td>@Model.Xe.KichThuoc</td></tr>
                    <tr><th>Màu sắc</th><td>@Model.Xe.MauSac</td></tr>
                </table>
            </section>


            <div class="section-box">
                <h3 class="section-title">Mô tả chi tiết</h3>
                <div id="descContent" class="desc-content">
                    @if (!string.IsNullOrEmpty(Model.Xe.MoTaChiTiet))
                    {
                        @Html.Raw(Model.Xe.MoTaChiTiet.Replace("\n", "<br>"))
                    }
                    else
                    {
                        <p>Người bán chưa nhập mô tả chi tiết.</p>
                    }
                    <div class="desc-fade" id="descFade"></div>
                </div>
                <button id="toggleBtn" class="btn-toggle-desc">Xem thêm <i class="fas fa-chevron-down"></i></button>
            </div>

            @{
                var listDanhGia = ViewBag.ListDanhGia as List<TKW.Models.DanhGia>;
            }

            <div class="section-box mt-4">
                <h3 class="section-title">Đánh giá xe (@(listDanhGia != null ? listDanhGia.Count : 0))</h3>

                <div class="review-list">
                    @if (listDanhGia != null && listDanhGia.Count > 0)
                    {
                        foreach (var dg in listDanhGia)
                        {
                            <div class="review-item">
                                <div class="review-avatar" style="background-color: #@(Guid.NewGuid().ToString().Substring(0, 6))">
                                    @(dg.NguoiDung.HoTen.Substring(0, 1).ToUpper())
                                </div>
                                <div class="review-content">
                                    <div class="review-header">
                                        <span class="review-name">@dg.NguoiDung.HoTen</span>
                                        <span class="review-date">@dg.NgayDanhGia.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="star-rating-static mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= dg.SoSao)
                                            {<i class="fas fa-star"></i> }
                                            else
                                            { <i class="far fa-star" style="color:#ccc"></i>}
                                        }
                                    </div>
                                    <p class="review-text">@dg.NoiDung</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Chưa có đánh giá nào. Hãy là người đầu tiên!</p>
                    }
                </div>

                <div class="review-form-box">
                    <h5 class="font-weight-bold mb-3">Viết đánh giá của bạn</h5>
                    <form id="formDanhGia">
                        <input type="hidden" id="idXeInput" value="@Model.IdXe" />

                        <div class="d-flex align-items-center mb-2">
                            <span class="mr-3 font-weight-600">Chất lượng xe:</span>
                            <div class="star-rating-input">
                                <input type="radio" name="rating" id="star5" value="5" checked><label for="star5"><i class="fas fa-star"></i></label>
                                <input type="radio" name="rating" id="star4" value="4"><label for="star4"><i class="fas fa-star"></i></label>
                                <input type="radio" name="rating" id="star3" value="3"><label for="star3"><i class="fas fa-star"></i></label>
                                <input type="radio" name="rating" id="star2" value="2"><label for="star2"><i class="fas fa-star"></i></label>
                                <input type="radio" name="rating" id="star1" value="1"><label for="star1"><i class="fas fa-star"></i></label>
                            </div>
                        </div>

                        <textarea id="txtNoiDung" class="form-control-custom" rows="3" placeholder="Mời bạn chia sẻ cảm nhận về chiếc xe này..."></textarea>

                        <button type="button" onclick="submitReview()" class="btn btn-primary px-4 rounded-pill font-weight-bold">
                            <i class="fas fa-paper-plane mr-1"></i> Gửi đánh giá
                        </button>
                    </form>
                </div>
   
            </div>
    </div>

    <!-- SIMILAR -->
    <!-- Banner quảng cáo -->
    <div class="promo-banner">
        <img src="~/Content/Images/banner-kayauto.jpg" alt="Siêu Deal KayAuto" />
    </div>

    <section class="similar-box">
        <h2>Xe tương tự</h2>

        <div class="row similar-row">
            @foreach (var xe in Model.XeTuongTu)
            {
                var img = xe.XeHinhAnhs.FirstOrDefault()?.HinhAnh ?? "no-image.jpg";

                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-4">
                    <a href="/Xe/ChiTietXe/@xe.IdXe" class="similar-card">

                        <!-- ẢNH -->
                        <div class="sim-img-wrap">
                            <img src="~/Content/Images/@img" class="sim-img" />
                        </div>

                        <!-- TIÊU ĐỀ -->
                        <div class="sim-title">@xe.TieuDe</div>

                        <div class="car-info-row">
                            <div class="car-info-item">
                                <i class="fas fa-calendar"></i>
                                <span>No data</span>
                            </div>

                            <div class="car-info-item">
                                <i class="fas fa-road"></i>
                                <span>Xe mới</span>
                            </div>
                        </div>

                        <!-- HÀNG ICON 2 -->
                        <div class="car-info-row">
                            <div class="car-info-item">
                                <i class="fas fa-gas-pump"></i>
                                <span>@xe.NhienLieu</span>
                            </div>

                            <div class="car-info-item">
                                <i class="fas fa-cogs"></i>
                                <span>@xe.HopSo</span>
                            </div>
                        </div>

                        <!-- GIÁ -->
                        <div class="sim-price">@FormatGia(xe.Gia)</div>

                        <!-- ĐỊA ĐIỂM -->
                        <div class="sim-location">
                            <i class="fas fa-map-marker-alt"></i> @xe.DiaDiem
                        </div>

                    </a>
                </div>
            }
        </div>
    </section>
    <div class="promo-banner">
        <img src="~/Content/Images/banner-kayauto1.jpg" alt="Siêu Deal KayAuto" />
    </div>

</div>
<div class="modal fade" id="modalLaiThu" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-steering-wheel mr-2"></i>
                    Đăng ký lái thử
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <p>
                    Bạn đang đăng ký lái thử xe:
                    <strong class="text-danger">@Model.Xe.TieuDe</strong>
                </p>

                <!-- ID XE (BẮT BUỘC) -->
                <input type="hidden" id="lt_IdXe" value="@Model.Xe.IdXe" />

                <div class="form-group">
                    <label>Ngày & giờ muốn lái thử</label>
                    <input type="datetime-local" id="lt_NgayHen" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Ghi chú (nếu có)</label>
                    <textarea id="lt_GhiChu"
                              class="form-control"
                              rows="3"
                              placeholder="Ví dụ: Tôi rảnh buổi chiều..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">
                    Đóng
                </button>

                <!-- NÚT GỬI (BẮT BUỘC GỌI JS) -->
                <button type="button"
                        class="btn btn-primary"
                        onclick="guiYeuCauLaiThu()">
                    Gửi yêu cầu
                </button>
            </div>

        </div>
    </div>
</div>

@functions {
    string FormatGia(decimal gia)
    {
        long vnd = (long)gia;

        if (vnd < 1_000_000_000)
        {
            long trieu = vnd / 1_000_000;
            return $"{trieu:N0} triệu";
        }

        long ty = vnd / 1_000_000_000;
        long trieuConLai = (vnd % 1_000_000_000) / 1_000_000;

        if (trieuConLai > 0)
            return $"{ty} tỷ {trieuConLai:N0} triệu";

        return $"{ty} tỷ";
    }
}


<script>
    function changeImage(el) {
        document.getElementById("mainImage").src = el.src;
    }
    const btn = document.getElementById("toggleBtn");
    const content = document.getElementById("descContent");

    btn.addEventListener("click", function () {
        content.classList.toggle("expanded");

        if (content.classList.contains("expanded")) {
            btn.textContent = "Thu gọn";
        } else {
            btn.textContent = "Xem thêm";
        }
    });
    function guiYeuCauLaiThu() {
        var idXe = $('#lt_IdXe').val();
        var ngayHen = $('#lt_NgayHen').val();
        var ghiChu = $('#lt_GhiChu').val();

        if (!ngayHen) {
            alert("Vui lòng chọn ngày giờ bạn muốn lái thử!");
            return;
        }

        $.ajax({
            url: '/Xe/DangKyLaiThu',
            type: 'POST',
            data: {
                idXe: idXe,
                ngayHen: ngayHen,
                ghiChu: ghiChu
            },
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    $('#modalLaiThu').modal('hide'); // Đóng popup
                    $('#lt_GhiChu').val(''); // Xóa form
                    $('#lt_NgayHen').val('');
                } else {
                    alert(res.message);
                    if (res.message.includes("đăng nhập")) {
                        window.location.href = "/TaiKhoan/DangNhap";
                    }
                }
            },
            error: function () {
                alert("Lỗi kết nối server.");
            }
        });
    }
</script>

