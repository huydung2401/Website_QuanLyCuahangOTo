@model TKW.Models.DatCoc
@{
    Layout = null; // Không dùng Layout Admin để trang giấy trắng tinh
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Hóa đơn đặt cọc - @Model.IdDatCoc</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #eee;
            font-family: 'Times New Roman', Times, serif;
        }

        .invoice-box {
            max-width: 800px;
            margin: 30px auto;
            padding: 30px;
            border: 1px solid #eee;
            background: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
        }

        /* CSS dùng riêng cho Máy in */
        @@media print {
            body {
                background: white;
            }

            .invoice-box {
                box-shadow: none;
                border: none;
                margin: 0;
                width: 100%;
            }

            .btn-print {
                display: none;
            }
            /* Ẩn nút in khi đang in */
        }
    </style>
</head>
<body>

    <div class="invoice-box">
        <div class="text-end mb-4 btn-print">
            <button onclick="window.print()" class="btn btn-primary fw-bold"><i class="fa fa-print"></i> IN HÓA ĐƠN</button>
            <button onclick="window.close()" class="btn btn-secondary">Đóng</button>
        </div>

        <div class="row mb-4">
            <div class="col-2">
                <img src="https://via.placeholder.com/100" width="100" />
            </div>
            <div class="col-10 text-end">
                <h2 class="fw-bold text-uppercase">Biên lai đặt cọc</h2>
                <div>Mã phiếu: <strong>#@Model.IdDatCoc</strong></div>
                <div>Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <hr />

        <div class="mb-4">
            <strong>Đơn vị thụ hưởng:</strong><br>
            <span class="fs-5 fw-bold text-uppercase">Showroom Ô Tô Uy Tín</span><br>
            Địa chỉ: 123 Đường ABC, Quận XYZ, TP.HCM<br>
            Hotline: 0909.123.456
        </div>

        <div class="mb-4">
            <strong>Khách hàng:</strong><br>
            Họ tên: <span class="fw-bold">@Model.NguoiDung.HoTen</span><br>
            Số điện thoại: @Model.NguoiDung.DienThoai<br>
            Email: @Model.NguoiDung.Email
        </div>

        <table class="table table-bordered border-dark mb-4">
            <thead class="table-light border-dark">
                <tr>
                    <th>Nội dung thanh toán</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>Đặt cọc mua xe:</strong> @Model.Xe.TieuDe<br>
                        <small>Mã xe: @Model.IdXe | Năm SX: @Model.Xe.NamSX</small>
                    </td>
                    <td class="text-end fw-bold">@string.Format("{0:N0}", Model.SoTienCoc) VNĐ</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td class="text-end fw-bold">TỔNG CỘNG</td>
                    <td class="text-end fw-bold fs-5">@string.Format("{0:N0}", Model.SoTienCoc) VNĐ</td>
                </tr>
            </tfoot>
        </table>

        <div class="mb-5 fst-italic">
            <strong>Ghi chú:</strong> @Model.GhiChu <br />
            Số tiền bằng chữ: _______________________________________________________________
        </div>

        <div class="row text-center mt-5">
            <div class="col-6">
                <strong>Người nộp tiền</strong><br>
                (Ký, họ tên)
                <br><br><br><br>
                <span>@Model.NguoiDung.HoTen</span>
            </div>
            <div class="col-6">
                <strong>Người thu tiền</strong><br>
                (Ký, họ tên, đóng dấu)
                <br><br><br><br>
                <span>Admin/Kế toán</span>
            </div>
        </div>
    </div>

</body>
</html>