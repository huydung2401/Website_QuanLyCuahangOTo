@model IEnumerable<TKW.Areas.Admin.Models.DoanhThuVM>
@{
    ViewBag.Title = "Báo cáo doanh thu";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    // Chuẩn bị dữ liệu cho Biểu đồ (Chuyển từ List C# sang mảng JavaScript)
    var labels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrderBy(x => x.Thang).Select(x => "T" + x.Thang + "/" + x.Nam));
    var data = Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrderBy(x => x.Thang).Select(x => x.TongTien));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-primary"><i class="fa fa-chart-line"></i> BÁO CÁO TÀI CHÍNH</h4>
    <button onclick="window.print()" class="btn btn-outline-secondary"><i class="fa fa-print"></i> In báo cáo</button>
</div>

<div class="row mb-4">
    <a href="@Url.Action("Index", "QuanLyDatCoc", new { area = "Admin" })"
       class="card card-stat p-3 mb-3 d-block text-decoration-none text-dark"
       style="cursor:pointer;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="text-uppercase opacity-75">Tổng doanh thu thực tế</h6>
                <h2 class="display-6 fw-bold">@string.Format("{0:N0}", ViewBag.TongDoanhThu) đ</h2>
            </div>
        </div>
    </a>

    <div class="col-md-6">
        <div class="col-md-3">
            <a href="@Url.Action("Index", "QuanLyKhachHang", new { area = "Admin" })"
               class="card card-stat p-3 mb-3 d-block text-decoration-none text-dark"
               style="cursor:pointer;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75">Tổng số giao dịch thành công</h6>
                        <h2 class="display-6 fw-bold">@ViewBag.TongDonHang đơn</h2>
                        <p class="mb-0 small"><i class="fa fa-shopping-cart"></i> Số lượng xe đã nhận cọc</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card shadow border-0">
            <div class="card-header bg-white fw-bold">
                <i class="fa fa-chart-bar"></i> Biểu đồ doanh thu theo tháng
            </div>
            <div class="card-body">
                <canvas id="revenueChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow border-0">
            <div class="card-header bg-white fw-bold">
                <i class="fa fa-table"></i> Chi tiết theo tháng
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Thời gian</th>
                            <th class="text-center">Số đơn</th>
                            <th class="text-end">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">Tháng @item.Thang/@item.Nam</td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill">@item.SoDonHang</span></td>
                                <td class="text-end fw-bold text-success">
                                    @string.Format("{0:N0}", item.TongTien) đ
                                </td>
                            </tr>
                        }
                        @if (Model.Count() == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu doanh thu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var ctx = document.getElementById('revenueChart').getContext('2d');
    var myChart = new Chart(ctx, {
        type: 'bar', // Loại biểu đồ: Cột
        data: {
            labels: @Html.Raw(labels), // Dữ liệu tháng từ C#
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: @Html.Raw(data), // Dữ liệu tiền từ C#
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value, index, values) {
                            return value.toLocaleString() + ' đ'; // Format tiền trục Y
                        }
                    }
                }
            }
        }
    });
</script>